<view class="tab-bar {{isDark ? 'dark' : ''}}">
  <view class="tab-bar-inner">
    <view wx:for="{{list}}" wx:key="index" class="tab-item {{selected === index ? 'active' : ''}}" data-path="{{item.pagePath}}" data-index="{{index}}" bindtap="switchTab">
      <view class="tab-icon-bg {{selected === index ? 'active' : ''}}">
        <text class="tab-icon-text">{{item.icon}}</text>
      </view>
      <text class="tab-label">{{item.text}}</text>
      <view wx:if="{{selected === index}}" class="active-indicator"></view>
    </view>
  </view>
  <view class="bottom-safe"></view>
</view>
