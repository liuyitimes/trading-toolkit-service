.container {
  min-height: 100vh;
  background: #F6F8FA;
  display: flex;
  flex-direction: column;
  height: 100vh;
}

.toolbar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #D0D7DE;
}

.search-wrap {
  flex: 1;
  position: relative;
  display: flex;
  align-items: center;
}

.search-input {
  flex: 1;
  height: 64rpx;
  padding: 0 56rpx 0 24rpx;
  background: #F6F8FA;
  border: 1rpx solid #D0D7DE;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #1F2328;
}

.search-clear {
  position: absolute;
  right: 16rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 36rpx;
  height: 36rpx;
  line-height: 32rpx;
  text-align: center;
  background: #818B98;
  color: #fff;
  border-radius: 50%;
  font-size: 24rpx;
}

.toolbar-actions {
  display: flex;
  gap: 12rpx;
}

.toolbar-btn {
  padding: 12rpx 24rpx;
  background: #F6F8FA;
  border: 1rpx solid #D0D7DE;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #1F2328;
}

.toolbar-btn.danger {
  color: #CF222E;
  border-color: #CF222E;
  background: #FFE5E5;
}

.summary-bar {
  padding: 8rpx 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #F0F0F0;
}

.summary-text {
  font-size: 22rpx;
  color: #818B98;
}

.baseurl-bar {
  padding: 6rpx 24rpx;
  background: #FFFBE6;
  border-bottom: 1rpx solid #FFE58F;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.baseurl-label {
  font-size: 20rpx;
  color: #8C7B00;
  flex-shrink: 0;
}

.baseurl-text {
  flex: 1;
  font-size: 20rpx;
  color: #8C7B00;
  word-break: break-all;
}

.conn-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 10rpx 24rpx;
  background: #F0F0F0;
  border-bottom: 1rpx solid #D0D7DE;
}

.conn-bar.checking {
  background: #E6F4FF;
  border-bottom-color: #91CAFF;
}

.conn-bar.connected {
  background: #F6FFED;
  border-bottom-color: #B7EB8F;
}

.conn-bar.failed {
  background: #FFF1F0;
  border-bottom-color: #FFCCC7;
}

.conn-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #818B98;
  flex-shrink: 0;
}

.conn-bar.checking .conn-dot {
  background: #1677FF;
}

.conn-bar.connected .conn-dot {
  background: #52C41A;
}

.conn-bar.failed .conn-dot {
  background: #FF4D4F;
}

.conn-text {
  flex: 1;
  font-size: 22rpx;
  color: #59636E;
}

.conn-bar.checking .conn-text {
  color: #1677FF;
}

.conn-bar.connected .conn-text {
  color: #389E0D;
}

.conn-bar.failed .conn-text {
  color: #CF222E;
}

.conn-copy {
  padding: 4rpx 16rpx;
  background: rgba(0,0,0,0.06);
  border-radius: 4rpx;
  font-size: 20rpx;
  color: #59636E;
}

.error-panel {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 32rpx 24rpx;
  margin: 24rpx;
  background: #fff;
  border: 1rpx solid #FFCCC7;
  border-radius: 12rpx;
  flex-direction: column;
}

.error-icon {
  font-size: 48rpx;
  color: #FF4D4F;
  text-align: center;
  width: 100%;
}

.error-content {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.error-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #CF222E;
  text-align: center;
}

.error-detail {
  font-size: 24rpx;
  color: #59636E;
  line-height: 1.6;
  word-break: break-all;
  white-space: pre-wrap;
}

.error-hint {
  font-size: 22rpx;
  color: #818B98;
  background: #FFFBE6;
  padding: 12rpx 16rpx;
  border-radius: 6rpx;
  line-height: 1.5;
}

.error-actions {
  display: flex;
  gap: 16rpx;
  width: 100%;
  margin-top: 8rpx;
}

.error-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border: 1rpx solid #D0D7DE;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #1F2328;
  background: #fff;
}

.error-btn.primary {
  background: #1A1A2E;
  color: #fff;
  border-color: #1A1A2E;
}

.error-tip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  background: #FFF1F0;
  border-bottom: 1rpx solid #FFCCC7;
}

.error-tip-text {
  flex: 1;
  font-size: 24rpx;
  color: #CF222E;
  word-break: break-all;
}

.error-tip-retry {
  padding: 6rpx 20rpx;
  background: #CF222E;
  color: #fff;
  border-radius: 6rpx;
  font-size: 22rpx;
}

.loading-bar {
  padding: 40rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #818B98;
}

.log-scroll {
  flex: 1;
  height: 0;
}

.log-list {
  padding: 0 16rpx;
}

.log-card {
  margin: 8rpx 0;
  background: #fff;
  border-radius: 8rpx;
  border: 1rpx solid #D0D7DE;
  overflow: hidden;
}

.log-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 20rpx;
}

.log-method {
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #fff;
  background: #818B98;
  min-width: 60rpx;
  text-align: center;
}

.log-method.get {
  background: #1A7F37;
}

.log-method.post {
  background: #D4A017;
}

.log-path {
  flex: 1;
  font-size: 24rpx;
  color: #1F2328;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  word-break: break-all;
}

.log-status {
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  font-size: 22rpx;
  font-weight: 600;
  background: #D3F8DF;
  color: #1A7F37;
  min-width: 50rpx;
  text-align: center;
}

.log-status.error {
  background: #FFE5E5;
  color: #CF222E;
}

.log-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 0 20rpx 12rpx;
  flex-wrap: wrap;
}

.log-time {
  font-size: 22rpx;
  color: #818B98;
}

.log-duration {
  font-size: 22rpx;
  color: #59636E;
  font-weight: 500;
}

.log-duration.slow {
  color: #CF222E;
  font-weight: 600;
}

.log-truncated-tag {
  padding: 2rpx 10rpx;
  background: #FFE58F;
  color: #8C7B00;
  border-radius: 4rpx;
  font-size: 20rpx;
}

.log-expand-hint {
  margin-left: auto;
  font-size: 22rpx;
  color: #57606A;
}

.log-body {
  border-top: 1rpx solid #F0F0F0;
  padding: 16rpx 20rpx;
  background: #FAFBFC;
}

.body-section {
  margin-bottom: 16rpx;
}

.body-section:last-child {
  margin-bottom: 0;
}

.body-label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.body-label {
  font-size: 22rpx;
  color: #59636E;
  font-weight: 600;
}

.copy-hint {
  font-size: 20rpx;
  color: #818B98;
}

.json-view {
  background: #F6F8FA;
  border: 1rpx solid #D0D7DE;
  border-radius: 6rpx;
  padding: 16rpx;
  max-height: 600rpx;
  box-sizing: border-box;
}

.json-text {
  display: block;
  font-size: 22rpx;
  color: #1F2328;
  font-family: Consolas, Monaco, monospace;
  white-space: pre;
  line-height: 1.6;
  word-break: break-all;
  word-wrap: break-word;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.empty-text {
  font-size: 30rpx;
  color: #59636E;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #818B98;
  margin-bottom: 32rpx;
}

.empty-refresh {
  padding: 12rpx 48rpx;
  background: #1A1A2E;
  color: #fff;
  border-radius: 8rpx;
  font-size: 26rpx;
}

.load-more-bar {
  display: flex;
  justify-content: center;
  padding: 32rpx;
}

.load-more-btn {
  padding: 16rpx 64rpx;
  background: #fff;
  border: 1rpx solid #D0D7DE;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #59636E;
}

.load-more-btn.loading {
  color: #818B98;
  background: #F6F8FA;
}

.bottom-tip {
  text-align: center;
  padding: 32rpx;
  font-size: 22rpx;
  color: #818B98;
}
