<view class="container">
  <view class="toolbar">
    <view class="search-wrap">
      <input class="search-input" placeholder="搜索路径或响应" value="{{search}}" bindinput="onSearchInput" bindconfirm="doSearch" confirm-type="search" />
      <view wx:if="{{search}}" class="search-clear" catchtap="clearSearch">×</view>
    </view>
    <view class="toolbar-actions">
      <view class="toolbar-btn" bindtap="doRefresh">
        <text>刷新</text>
      </view>
      <view class="toolbar-btn danger" bindtap="clearLogs">
        <text>清空</text>
      </view>
    </view>
  </view>

  <view class="conn-bar {{connStatus}}">
    <view class="conn-dot"></view>
    <text class="conn-text" wx:if="{{connStatus === 'checking'}}">正在检测后端连接...</text>
    <text class="conn-text" wx:elif="{{connStatus === 'connected'}}">已连接{{pingDuration ? ' · 探测 ' + pingDuration + 'ms' : ''}}</text>
    <text class="conn-text" wx:elif="{{connStatus === 'failed'}}">连接失败 · {{errorTitle}}</text>
    <text class="conn-text" wx:else>未检测</text>
    <view class="conn-copy" catchtap="copyBaseUrl" wx:if="{{connStatus !== 'checking'}}">复制地址</view>
  </view>

  <view class="baseurl-bar" catchtap="copyBaseUrl">
    <text class="baseurl-label">后端:</text>
    <text class="baseurl-text">{{baseUrl}}</text>
  </view>

  <view class="error-panel" wx:if="{{connStatus === 'failed'}}">
    <view class="error-icon">⚠</view>
    <view class="error-content">
      <text class="error-title">{{errorTitle}}</text>
      <text class="error-detail" decode>{{errorDetail}}</text>
      <text class="error-hint" wx:if="{{baseUrlInfo.type === 'lan'}}">提示: {{baseUrlInfo.hint}}</text>
      <text class="error-hint" wx:if="{{baseUrlInfo.type === 'localhost'}}">提示: {{baseUrlInfo.hint}}</text>
    </view>
    <view class="error-actions">
      <view class="error-btn primary" bindtap="goToSetting">去设置</view>
      <view class="error-btn" bindtap="doRefresh">重试</view>
    </view>
  </view>

  <view class="summary-bar" wx:if="{{connStatus === 'connected' && total > 0}}">
    <text class="summary-text">共 {{total}} 条日志 · 当前 {{logs.length}} 条</text>
  </view>

  <view class="loading-bar" wx:if="{{loading && connStatus !== 'failed'}}">
    <text>{{connStatus === 'checking' ? '正在连接后端...' : '加载中...'}}</text>
  </view>

  <scroll-view class="log-scroll" scroll-y enhanced enable-flex wx:if="{{connStatus === 'connected' && logs.length > 0}}">
    <view class="log-list">
      <view class="log-card" wx:for="{{logs}}" wx:key="id" data-index="{{index}}" bindtap="toggleExpand">
        <view class="log-header">
          <view class="log-method {{item.method === 'GET' ? 'get' : item.method === 'POST' ? 'post' : ''}}">{{item.method}}</view>
          <text class="log-path">{{item.path}}</text>
          <view class="log-status {{item.status >= 400 ? 'error' : 'ok'}}">{{item.status}}</view>
        </view>
        <view class="log-meta">
          <text class="log-time">{{item.time}}</text>
          <text class="log-duration {{item.duration > 1000 ? 'slow' : ''}}">{{item.duration}}ms</text>
          <view class="log-truncated-tag" wx:if="{{item.truncated}}">已截断</view>
          <view class="log-expand-hint">{{item.expanded ? '收起 ▲' : '展开 ▼'}}</view>
        </view>
        <view class="log-body" wx:if="{{item.expanded}}" catchtap="copyLog" data-index="{{index}}">
          <view class="body-section" wx:if="{{item.request_body_view}}">
            <view class="body-label-row">
              <text class="body-label">请求正文</text>
            </view>
            <scroll-view class="json-view" scroll-y>
              <text class="json-text" user-select="{{true}}" decode>{{item.request_body_view}}</text>
            </scroll-view>
          </view>
          <view class="body-section">
            <view class="body-label-row">
              <text class="body-label">响应数据</text>
              <text class="copy-hint">点击区域可复制</text>
            </view>
            <scroll-view class="json-view" scroll-y>
              <text class="json-text" user-select="{{true}}" decode>{{item.response_body_view}}</text>
            </scroll-view>
          </view>
        </view>
      </view>
    </view>
    <view class="load-more-bar" wx:if="{{hasMore}}">
      <view class="load-more-btn {{loading ? 'loading' : ''}}" catchtap="loadMore">
        <text>{{loading ? '加载中...' : '加载更多'}}</text>
      </view>
    </view>
    <view class="bottom-tip" wx:if="{{!hasMore && logs.length > 0}}">
      <text>— 已加载全部 —</text>
    </view>
  </scroll-view>

  <view class="empty-state" wx:if="{{connStatus === 'connected' && !loading && logs.length === 0 && !errorMsg}}">
    <text class="empty-text">暂无日志数据</text>
    <text class="empty-hint">发送 API 请求后会自动记录</text>
    <view class="empty-refresh" bindtap="doRefresh">刷新</view>
  </view>

  <view class="empty-state" wx:if="{{connStatus === 'connected' && errorMsg}}">
    <text class="empty-text">{{errorMsg}}</text>
    <view class="empty-refresh" bindtap="doRefresh">重试</view>
  </view>
</view>
