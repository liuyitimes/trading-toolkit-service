}

.dark-mode .market-overview {
  background: #161B22;
  border-color: #30363D;
}

.dark-mode .overview-title {
  color: #E6EDF3;
}

.dark-mode .market-status-tag {
  background: #1A3A5C;
  color: #F0C850;
  border-color: #1D4E89;
}

.dark-mode .overview-item {
  background: #0D1117;
}

.dark-mode .overview-value {
  color: #E6EDF3;
}

.dark-mode .overview-label {
  color: #8B949E;
}

.dark-mode .signal-stats {
  background: #161B22;
  border-color: #30363D;
}

.dark-mode .stat-item.active {
  background: #1A3A5C;
  border-color: #1D4E89;
}

.dark-mode .stat-value {
  color: #E6EDF3;
}

.dark-mode .stat-item.active .stat-value {
  color: #F0C850;
}

.dark-mode .stat-label {
  color: #8B949E;
}

.dark-mode .guide-section {
  background: #0D1117;
}

.dark-mode .guide-item {
  background: #3D2E00;
  border-color: #9E6A03;
}

.dark-mode .guide-text {
  color: #E6EDF3;
}

.dark-mode .table {
  background: #161B22;
  border-color: #30363D;
}

.dark-mode .table-header {
  background: #0D1117;
  border-color: #30363D;
  color: #8B949E;
}

.dark-mode .table-row {
  border-color: #21262D;
}

.dark-mode .table-row:active {
  background: #0D1117;
}

.dark-mode .bond-name {
  color: #E6EDF3;
}

.dark-mode .code-row {
  color: #8B949E;
}

.dark-mode .bond-code {
  color: #8B949E;
}

.dark-mode .stock-code {
  color: #6E7681;
}

.dark-mode .price-main {
  color: #E6EDF3;
}

.dark-mode .price-sub {
  color: #6E7681;
}

.dark-mode .premium-value {
  color: #F85149;
}

.dark-mode .premium-value.negative {
  color: #3FB950;
}

.dark-mode .extra-value {
  color: #E6EDF3;
}

.dark-mode .placement-label {
  color: #6E7681;
}

.dark-mode .placement-value {
  color: #E6EDF3;
}

.dark-mode .placement-value.highlight {
