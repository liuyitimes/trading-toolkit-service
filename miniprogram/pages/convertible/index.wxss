  background: #0D1117;
}

.dark-mode .search-bar {
  background: #161B22;
  border-color: #30363D;
}

.dark-mode .page-title {
  color: #E6EDF3;
}

.dark-mode .search-input {
  background: #0D1117;
  color: #E6EDF3;
}

.dark-mode .search-cancel {
