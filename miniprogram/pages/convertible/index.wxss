/* ==================== 可转债页面样式 - 旺财金主题 ==================== */
.container {
  min-height: 100vh;
  background: #F8F7F4;
}

/* ==================== 搜索栏 ==================== */
.search-bar {
  background: #FFFFFF;
  border-bottom: 1rpx solid #D0D7DE;
  position: sticky;
  top: 0;
  z-index: 100;
}

.search-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
}

.page-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1F2328;
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.search-btn {
  font-size: 36rpx;
}

.search-box {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  gap: 16rpx;
}

.search-input {
  flex: 1;
  height: 64rpx;
  padding: 0 24rpx;
  background: #F6F8FA;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #1F2328;
}

.search-cancel {
  font-size: 28rpx;
  color: #D4A017;
  padding: 0 8rpx;
}

/* ==================== 市场温度概览 ==================== */
.market-overview {
  background: #FFFFFF;
  border-bottom: 1rpx solid #D0D7DE;
  padding: 24rpx 20rpx;
}

.overview-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.overview-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2328;
}

.market-status-tag {
  padding: 6rpx 16rpx;
  background: #DAFBE1;
  color: #1A7F37;
  border: 1rpx solid #4AC26B;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.overview-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
}

.overview-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 8rpx;
  background: #F6F8FA;
  border-radius: 8rpx;
}

.overview-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #1F2328;
  line-height: 1.2;
}

.overview-label {
  font-size: 20rpx;
  color: #818B98;
  margin-top: 6rpx;
}

/* ==================== 信号统计 ==================== */
.signal-stats {
  display: flex;
  background: #FFFFFF;
  border-bottom: 1rpx solid #D0D7DE;
  padding: 16rpx 20rpx;
  gap: 12rpx;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 8rpx;
  border-radius: 8rpx;
  transition: all 0.2s ease;
  border: 1rpx solid transparent;
}

.stat-item.active {
  background: #DDF4FF;
  border-color: #54AEFF;
}

.stat-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #1F2328;
  line-height: 1.2;
}

.stat-item.active .stat-value {
  color: #D4A017;
}

.stat-label {
  font-size: 22rpx;
  color: #59636E;
  margin-top: 4rpx;
}

/* ==================== 投资指引 ==================== */
.guide-section {
  padding: 16rpx 20rpx;
}

.guide-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 16rpx 20rpx;
  background: #FFF8C5;
  border: 1rpx solid #EAC54F;
  border-radius: 8rpx;
}

.guide-icon {
  font-size: 28rpx;
  flex-shrink: 0;
}

.guide-text {
  font-size: 24rpx;
  color: #1F2328;
  line-height: 1.5;
  flex: 1;
}

/* ==================== 内容区域 ==================== */
.content {
  padding: 20rpx;
}

/* ==================== 可转债列表 ==================== */
/* ==================== 表格样式 ==================== */
.table {
  background: #FFFFFF;
  border-top: 1rpx solid #D0D7DE;
  border-bottom: 1rpx solid #D0D7DE;
}

.table-header {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  background: #F6F8FA;
  border-bottom: 1rpx solid #D0D7DE;
  font-size: 24rpx;
  color: #656D76;
  font-weight: 500;
}

.table-header .col-name {
  flex: 2.2;
}

.table-header .col-price {
  flex: 1.4;
  text-align: center;
}

.table-header .col-premium {
  flex: 1.2;
  text-align: center;
}

.table-header .col-extra {
  flex: 1.2;
  text-align: right;
}

.table-header .col-extra.placement-extra {
  flex: 1.6;
}

.table-body {
  display: flex;
  flex-direction: column;
}

.table-row {
  display: flex;
  align-items: center;
  padding: 20rpx;
  border-bottom: 1rpx solid #EAEef2;
}

.table-row:last-child {
  border-bottom: none;
}

.table-row:active {
  background: #F6F8FA;
}

.col-name {
  flex: 2.2;
  min-width: 0;
}

.name-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 6rpx;
}

.exchange-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 28rpx;
  height: 28rpx;
  border-radius: 4rpx;
  font-size: 18rpx;
  font-weight: 700;
  color: #fff;
  flex-shrink: 0;
}

.exchange-icon.sh {
  background: #CF222E;
}

.exchange-icon.sz {
  background: #1A7F37;
}

.exchange-icon.bj {
  background: #8250DF;
}

.exchange-icon.hk {
  background: #D4A017;
}

.bond-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1F2328;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.fav-icon {
  font-size: 30rpx;
  color: #D0D7DE;
  padding: 4rpx 8rpx;
  flex-shrink: 0;
}

.fav-icon.active {
  color: #9A6700;
}

.code-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 22rpx;
  color: #818B98;
}

.bond-code {
  font-family: monospace;
  color: #656D76;
}

.stock-code {
  color: #818B98;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
}

.col-price {
  flex: 1.4;
  text-align: center;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.price-main {
  font-size: 28rpx;
  font-weight: 600;
  color: #1F2328;
  font-family: monospace;
}

.price-sub {
  font-size: 22rpx;
  color: #818B98;
  font-family: monospace;
}

.col-premium {
  flex: 1.2;
  text-align: center;
}

.premium-value {
  font-size: 28rpx;
  font-weight: 600;
  color: #CF222E;
  font-family: monospace;
}

.premium-value.negative {
  color: #1A7F37;
}

.premium-value.high {
  color: #9A6700;
}

.col-extra {
  flex: 1.2;
  text-align: right;
}

.col-extra.placement-extra {
  flex: 1.6;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  align-items: flex-end;
  justify-content: center;
}

.placement-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.placement-label {
  font-size: 20rpx;
  color: #818B98;
}

.placement-value {
  font-size: 24rpx;
  font-weight: 600;
  color: #1F2328;
  font-family: monospace;
}

.placement-value.highlight {
  color: #D4A017;
}

.placement-value.warning {
  color: #9A6700;
}

.placement-value.positive {
  color: #CF222E;
}

.placement-value.negative {
  color: #1A7F37;
}

.extra-value {
  font-size: 28rpx;
  font-weight: 600;
  color: #1F2328;
  font-family: monospace;
}

.extra-value.highlight {
  color: #D4A017;
}

.extra-value.warning {
  color: #9A6700;
}

.extra-value.positive {
  color: #CF222E;
}

/* ==================== 空状态 ==================== */
.empty {
  text-align: center;
  padding: 120rpx 40rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #818B98;
}

/* ==================== 加载状态 ==================== */
.loading-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: #F6F8FA;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.loading-content {
  text-align: center;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 3rpx solid #D0D7DE;
  border-top-color: #D4A017;
  border-radius: 50%;
  animation: spin 0.6s linear infinite;
  margin: 0 auto 16rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #59636E;
}

/* ==================== 暗夜模式覆盖 ==================== */
