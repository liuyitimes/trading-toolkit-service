/* ==================== LOF基金页面样式 - GitHub风格 ==================== */
.container {
  min-height: 100vh;
  background: #F6F8FA;
  padding-bottom: 40rpx;
}

/* ==================== 搜索栏 ==================== */
.search-bar {
  background: #FFFFFF;
  border-bottom: 1rpx solid #D0D7DE;
  position: sticky;
  top: 0;
  z-index: 100;
}

.search-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
}

.page-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1F2328;
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.search-btn {
  font-size: 36rpx;
}

.search-box {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  gap: 16rpx;
}

.search-input {
  flex: 1;
  height: 64rpx;
  padding: 0 24rpx;
  background: #F6F8FA;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #1F2328;
}

.search-cancel {
  font-size: 28rpx;
  color: #0969DA;
  padding: 0 8rpx;
}

.fav-icon {
  font-size: 28rpx;
  color: #D0D7DE;
  margin-left: 4rpx;
}

.fav-icon.active {
  color: #9A6700;
}

/* ==================== 市场概览 ==================== */
.market-summary {
  background: #FFFFFF;
  border-bottom: 1rpx solid #D0D7DE;
  padding: 24rpx 20rpx;
}

.summary-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.summary-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1F2328;
}

.summary-time {
  font-size: 22rpx;
  color: #818B98;
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 8rpx;
}

.summary-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 4rpx;
  background: #F6F8FA;
  border-radius: 8rpx;
}

.summary-value {
  font-size: 28rpx;
  font-weight: 700;
  color: #1F2328;
  line-height: 1.2;
}

.summary-value.highlight {
  color: #CF222E;
}

.summary-value.arbitrage {
  color: #1A7F37;
}

.summary-value.warn {
  color: #9A6700;
}

.summary-label {
  font-size: 18rpx;
  color: #818B98;
  margin-top: 4rpx;
}

/* ==================== 投资指引 ==================== */
.guide-section {
  padding: 16rpx 20rpx;
}

.guide-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 16rpx 20rpx;
  background: #FFF8C5;
  border: 1rpx solid #EAC54F;
  border-radius: 8rpx;
}

.guide-icon {
  font-size: 28rpx;
  flex-shrink: 0;
}

.guide-text {
  font-size: 24rpx;
  color: #1F2328;
  line-height: 1.5;
  flex: 1;
}

/* ==================== 数据表格 ==================== */
.table {
  background: #FFFFFF;
  border: 1rpx solid #D0D7DE;
  border-radius: 12rpx;
  overflow: hidden;
  margin: 0 20rpx;
  box-shadow: 0 1px 0 rgba(31, 35, 40, 0.04);
}

.table-header {
  display: flex;
  background: #F6F8FA;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #D0D7DE;
}

.table-header text {
  font-size: 22rpx;
  font-weight: 600;
  color: #59636E;
}

.table-body {
  max-height: 1100rpx;
  overflow-y: auto;
}

.table-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #D0D7DE;
}

.table-row:last-child {
  border-bottom: none;
}

.table-row.highlight {
  background: #FFEBE9;
}

/* ==================== 表格列 ==================== */
.col-name {
  flex: 2.5;
  padding-left: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.col-price {
  flex: 1.5;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.col-premium {
  flex: 1.5;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.col-volume {
  flex: 1.2;
  display: flex;
  justify-content: center;
}

.col-tags {
  flex: 1.5;
  display: flex;
  flex-wrap: wrap;
  gap: 4rpx;
  padding-right: 12rpx;
  justify-content: flex-end;
}

/* ==================== 名称行 ==================== */
.name-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.exchange-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 32rpx;
  height: 32rpx;
  border-radius: 6rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: #fff;
  flex-shrink: 0;
}

.exchange-icon.sh { background: #CF222E; }
.exchange-icon.sz { background: #1A7F37; }
.exchange-icon.bj { background: #8250DF; }
.exchange-icon.hk { background: #0969DA; }

.fund-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #1F2328;
  line-height: 1.3;
}

.code-row {
  display: flex;
  align-items: center;
  gap: 6rpx;
  flex-wrap: wrap;
}

.fund-code {
  font-size: 22rpx;
  color: #818B98;
}

.fund-limit {
  font-size: 18rpx;
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
  background: #DAFBE1;
  color: #1A7F37;
  font-weight: 500;
}

.fund-limit.paused { background: #FFEBE9; color: #CF222E; }
.fund-limit.limited { background: #FFF8E5; color: #9A6700; border: 1rpx solid #D4A72C; }

/* ==================== 成交额标签(行内) ==================== */
.amount-tag {
  font-size: 18rpx;
  padding: 1rpx 8rpx;
  border-radius: 4rpx;
  font-weight: 500;
}

.amount-tag.safe { background: #DAFBE1; color: #1A7F37; }
.amount-tag.warn { background: #FFF8E5; color: #9A6700; }
.amount-tag.danger { background: #FFEBE9; color: #CF222E; }

/* ==================== 价格信息 ==================== */
.price-main {
  font-size: 28rpx;
  font-weight: 600;
  color: #1F2328;
  margin-bottom: 4rpx;
}

.price-main.positive { color: #CF222E; }
.price-main.negative { color: #1A7F37; }

.price-sub {
  font-size: 22rpx;
  color: #818B98;
}

.price-sub.positive { color: #CF222E; }
.price-sub.negative { color: #1A7F37; }

/* ==================== 溢价率 ==================== */
.premium-value {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A7F37;
  display: block;
  text-align: center;
}

.premium-value.high { color: #CF222E; }

.premium-sub {
  display: block;
  font-size: 18rpx;
  color: #818B98;
  text-align: center;
  margin-top: 2rpx;
}

.premium-sub.high { color: #CF222E; font-weight: 600; }
.premium-sub.negative { color: #1A7F37; }

/* ==================== 成交额列 ==================== */
.volume-value {
  font-size: 24rpx;
  font-weight: 600;
  color: #1F2328;
  font-family: monospace;
}

.volume-value.safe { color: #1A7F37; }
.volume-value.warn { color: #9A6700; }
.volume-value.danger { color: #CF222E; }

/* ==================== 标记列 ==================== */
.tag {
  font-size: 18rpx;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.tag-arbitrage {
  background: #DAFBE1;
  color: #1A7F37;
  border: 1rpx solid #4AC26B;
}

.tag-sustained {
  background: #EBF5FF;
  color: #0969DA;
  border: 1rpx solid #58A6FF;
}

.tag-warning {
  background: #FFF8E5;
  color: #9A6700;
  border: 1rpx solid #D4A72C;
}

/* ==================== 空状态 ==================== */
.empty {
  text-align: center;
  padding: 120rpx 40rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #818B98;
}

/* ==================== 加载状态 ==================== */
.loading {
  text-align: center;
  padding: 80rpx 0;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 3rpx solid #D0D7DE;
  border-top-color: #0969DA;
  border-radius: 50%;
  animation: spin 0.6s linear infinite;
  margin: 0 auto 16rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #59636E;
}

/* ==================== Tab分类 ==================== */
.signal-stats {
  display: flex;
  gap: 12rpx;
  padding: 16rpx 20rpx;
  background: #FFFFFF;
  border-bottom: 1rpx solid #D0D7DE;
  overflow-x: auto;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 8rpx;
  border-radius: 8rpx;
  background: #F6F8FA;
  border: 1rpx solid transparent;
  min-width: 60rpx;
}

.stat-item.active {
  background: #EBF5FF;
  border-color: #58A6FF;
}

.stat-value {
  font-size: 28rpx;
  font-weight: 700;
  color: #1F2328;
}

.stat-value.highlight { color: #CF222E; }

.stat-label {
  font-size: 20rpx;
  color: #818B98;
  margin-top: 4rpx;
}

.stat-item.active .stat-label {
  color: #0969DA;
  font-weight: 600;
}

/* ==================== 详情弹窗 ==================== */
.lof-modal .modal-body {
  max-height: 70vh;
  overflow-y: auto;
}

.lof-modal .detail-section {
  margin-bottom: 20rpx;
}

.lof-modal .detail-section-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #1F2328;
  display: block;
  margin-bottom: 12rpx;
  padding-bottom: 8rpx;
  border-bottom: 1rpx solid #D0D7DE;
}

.lof-modal .detail-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 0;
}

.lof-modal .detail-item {
  width: 50%;
  padding: 8rpx 0;
  box-sizing: border-box;
}

.lof-modal .detail-item.highlight-box {
  background: #FFF8C5;
  border-radius: 6rpx;
  padding: 8rpx 12rpx;
  width: 50%;
  margin-bottom: 6rpx;
}

.lof-modal .detail-label {
  font-size: 22rpx;
  color: #818B98;
  display: block;
  margin-bottom: 2rpx;
}

.lof-modal .detail-value {
  font-size: 26rpx;
  font-weight: 600;
  color: #1F2328;
}

.lof-modal .detail-value.highlight { color: #D4A017; }

.advice-box {
  background: #F0FFF0;
  border: 1rpx solid #4AC26B;
  border-radius: 8rpx;
  padding: 16rpx;
}

.advice-text {
  font-size: 24rpx;
  color: #1F2328;
  line-height: 1.6;
}

/* ==================== 暗夜模式覆盖 ==================== */
.dark-mode .container { background: #0D1117; }
.dark-mode .search-bar { background: #161B22; border-color: #30363D; }
.dark-mode .page-title { color: #E6EDF3; }
.dark-mode .search-input { background: #0D1117; color: #E6EDF3; }
.dark-mode .search-cancel { color: #58A6FF; }
.dark-mode .fav-icon { color: #30363D; }
.dark-mode .fav-icon.active { color: #D29922; }
.dark-mode .market-summary { background: #161B22; border-color: #30363D; }
.dark-mode .summary-title { color: #E6EDF3; }
.dark-mode .summary-time { color: #6E7681; }
.dark-mode .summary-item { background: #0D1117; }
.dark-mode .summary-value { color: #E6EDF3; }
.dark-mode .summary-value.highlight { color: #F85149; }
.dark-mode .summary-value.arbitrage { color: #3FB950; }
.dark-mode .summary-value.warn { color: #D29922; }
.dark-mode .summary-label { color: #8B949E; }
.dark-mode .guide-item { background: #3D2E00; border-color: #9E6A03; }
.dark-mode .guide-text { color: #E6EDF3; }
.dark-mode .table { background: #161B22; border-color: #30363D; }
.dark-mode .table-header { background: #0D1117; border-color: #30363D; }
.dark-mode .table-header text { color: #8B949E; }
.dark-mode .table-row { border-color: #21262D; }
.dark-mode .table-row.highlight { background: #4D1F1F; }
.dark-mode .fund-name { color: #E6EDF3; }
.dark-mode .fund-code { color: #8B949E; }
.dark-mode .fund-limit { background: #1A4D2E; color: #3FB950; }
.dark-mode .fund-limit.paused { background: #4D1F1F; color: #F85149; }
.dark-mode .fund-limit.limited { background: #3D2E00; color: #D29922; }
.dark-mode .amount-tag.safe { background: #1A4D2E; color: #3FB950; }
.dark-mode .amount-tag.warn { background: #3D2E00; color: #D29922; }
.dark-mode .amount-tag.danger { background: #4D1F1F; color: #F85149; }
.dark-mode .price-main { color: #E6EDF3; }
.dark-mode .price-main.positive { color: #F85149; }
.dark-mode .price-main.negative { color: #3FB950; }
.dark-mode .price-sub { color: #6E7681; }
.dark-mode .price-sub.positive { color: #F85149; }
.dark-mode .price-sub.negative { color: #3FB950; }
.dark-mode .premium-value { color: #3FB950; }
.dark-mode .premium-value.high { color: #F85149; }
.dark-mode .premium-sub { color: #6E7681; }
.dark-mode .premium-sub.high { color: #F85149; }
.dark-mode .premium-sub.negative { color: #3FB950; }
.dark-mode .volume-value { color: #E6EDF3; }
.dark-mode .volume-value.safe { color: #3FB950; }
.dark-mode .volume-value.warn { color: #D29922; }
.dark-mode .volume-value.danger { color: #F85149; }
.dark-mode .tag-arbitrage { background: #1A4D2E; color: #3FB950; border-color: #238636; }
.dark-mode .tag-sustained { background: #0D2240; color: #58A6FF; border-color: #58A6FF; }
.dark-mode .tag-warning { background: #3D2E00; color: #D29922; border-color: #9E6A03; }
.dark-mode .signal-stats { background: #161B22; border-color: #30363D; }
.dark-mode .stat-item { background: #0D1117; }
.dark-mode .stat-item.active { background: #0D2240; border-color: #58A6FF; }
.dark-mode .stat-value { color: #E6EDF3; }
.dark-mode .stat-value.highlight { color: #F85149; }
.dark-mode .stat-label { color: #8B949E; }
.dark-mode .stat-item.active .stat-label { color: #58A6FF; }
.dark-mode .loading { background: #0D1117; }
.dark-mode .loading-spinner { border-color: #30363D; border-top-color: #58A6FF; }
.dark-mode .loading-text { color: #8B949E; }

/* 弹窗暗夜模式 */
.dark-mode .lof-modal .detail-section-title { color: #E6EDF3; border-color: #30363D; }
.dark-mode .lof-modal .detail-label { color: #6E7681; }
.dark-mode .lof-modal .detail-value { color: #E6EDF3; }
.dark-mode .lof-modal .detail-value.highlight { color: #F0C850; }
.dark-mode .lof-modal .detail-item.highlight-box { background: #3D2E00; }
.dark-mode .advice-box { background: #1A4D2E; border-color: #238636; }
.dark-mode .advice-text { color: #E6EDF3; }
