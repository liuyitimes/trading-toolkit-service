/* ==================== LOF基金页面样式 - GitHub风格 ==================== */
.container {
  min-height: 100vh;
  background: #F6F8FA;
  padding-bottom: 40rpx;
}

/* ==================== 搜索栏 ==================== */
.search-bar {
  background: #FFFFFF;
  border-bottom: 1rpx solid #D0D7DE;
  position: sticky;
  top: 0;
  z-index: 100;
}

.search-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
}

.page-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1F2328;
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.search-btn {
  font-size: 36rpx;
}

.search-box {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  gap: 16rpx;
}

.search-input {
  flex: 1;
  height: 64rpx;
  padding: 0 24rpx;
  background: #F6F8FA;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #1F2328;
}

.search-cancel {
  font-size: 28rpx;
  color: #0969DA;
  padding: 0 8rpx;
}

.fav-icon {
  font-size: 28rpx;
  color: #D0D7DE;
  margin-left: 4rpx;
}

.fav-icon.active {
  color: #9A6700;
}

/* ==================== 市场概览 ==================== */
.market-summary {
  background: #FFFFFF;
  border-bottom: 1rpx solid #D0D7DE;
  padding: 24rpx 20rpx;
}

.summary-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.summary-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1F2328;
}

.summary-time {
  font-size: 22rpx;
  color: #818B98;
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
}

.summary-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 8rpx;
  background: #F6F8FA;
  border-radius: 8rpx;
}

.summary-value {
  font-size: 30rpx;
  font-weight: 700;
  color: #1F2328;
  line-height: 1.2;
}

.summary-value.highlight {
  color: #CF222E;
}

.summary-label {
  font-size: 20rpx;
  color: #818B98;
  margin-top: 6rpx;
}

/* ==================== 投资指引 ==================== */
.guide-section {
  padding: 16rpx 20rpx;
}

.guide-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 16rpx 20rpx;
  background: #FFF8C5;
  border: 1rpx solid #EAC54F;
  border-radius: 8rpx;
}

.guide-icon {
  font-size: 28rpx;
  flex-shrink: 0;
}

.guide-text {
  font-size: 24rpx;
  color: #1F2328;
  line-height: 1.5;
  flex: 1;
}

/* ==================== 数据表格 ==================== */
.table {
  background: #FFFFFF;
  border: 1rpx solid #D0D7DE;
  border-radius: 12rpx;
  overflow: hidden;
  margin: 0 20rpx;
  box-shadow: 0 1px 0 rgba(31, 35, 40, 0.04);
}

.table-header {
  display: flex;
  background: #F6F8FA;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #D0D7DE;
}

.table-header text {
  font-size: 22rpx;
  font-weight: 600;
  color: #59636E;
}

.table-body {
  max-height: 1100rpx;
  overflow-y: auto;
}

.table-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #D0D7DE;
}

.table-row:last-child {
  border-bottom: none;
}

.table-row.highlight {
  background: #FFEBE9;
}

/* ==================== 表格列 ==================== */
.col-name {
  flex: 2.5;
  padding-left: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.col-price {
  flex: 1.8;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.col-premium {
  flex: 1.2;
  display: flex;
  justify-content: center;
}

.col-days {
  flex: 1;
  display: flex;
  justify-content: center;
}

/* ==================== 名称行 ==================== */
.name-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.exchange-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 32rpx;
  height: 32rpx;
  border-radius: 6rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: #fff;
  flex-shrink: 0;
}

.exchange-icon.sh {
  background: #CF222E;
}

.exchange-icon.sz {
  background: #1A7F37;
}

.exchange-icon.bj {
  background: #8250DF;
}

.exchange-icon.hk {
  background: #0969DA;
}

.fund-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #1F2328;
  line-height: 1.3;
}

.code-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.fund-code {
  font-size: 22rpx;
  color: #818B98;
}

.fund-limit {
  font-size: 18rpx;
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
  background: #DAFBE1;
  color: #1A7F37;
  font-weight: 500;
}

.fund-limit.paused {
  background: #FFEBE9;
  color: #CF222E;
}

/* ==================== 价格信息 ==================== */
.price-main {
  font-size: 28rpx;
  font-weight: 600;
  color: #1F2328;
  margin-bottom: 4rpx;
}

.price-sub {
  font-size: 22rpx;
  color: #818B98;
}

/* ==================== 溢价率 ==================== */
.premium-value {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A7F37;
}

.premium-value.high {
  color: #CF222E;
}

/* ==================== 天数 ==================== */
.days-value {
  font-size: 24rpx;
  color: #1F2328;
  font-weight: 500;
}

/* ==================== 空状态 ==================== */
.empty {
  text-align: center;
  padding: 120rpx 40rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #818B98;
}

/* ==================== 加载状态 ==================== */
.loading {
  text-align: center;
  padding: 80rpx 0;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 3rpx solid #D0D7DE;
  border-top-color: #0969DA;
  border-radius: 50%;
  animation: spin 0.6s linear infinite;
  margin: 0 auto 16rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #59636E;
}

/* ==================== 暗夜模式覆盖 ==================== */
.dark-mode .container {
  background: #0D1117;
}

.dark-mode .search-bar {
  background: #161B22;
  border-color: #30363D;
}

.dark-mode .page-title {
  color: #E6EDF3;
}

.dark-mode .search-input {
  background: #0D1117;
  color: #E6EDF3;
}

.dark-mode .search-cancel {
  color: #58A6FF;
}

.dark-mode .fav-icon {
  color: #30363D;
}

.dark-mode .fav-icon.active {
  color: #D29922;
}

.dark-mode .market-summary {
  background: #161B22;
  border-color: #30363D;
}

.dark-mode .summary-title {
  color: #E6EDF3;
}

.dark-mode .summary-time {
  color: #6E7681;
}

.dark-mode .summary-item {
  background: #0D1117;
}

.dark-mode .summary-value {
  color: #E6EDF3;
}

.dark-mode .summary-label {
  color: #8B949E;
}

.dark-mode .guide-item {
  background: #3D2E00;
  border-color: #9E6A03;
}

.dark-mode .guide-text {
  color: #E6EDF3;
}

.dark-mode .table {
  background: #161B22;
  border-color: #30363D;
}

.dark-mode .table-header {
  background: #0D1117;
  border-color: #30363D;
}

.dark-mode .table-header text {
  color: #8B949E;
}

.dark-mode .table-row {
  border-color: #21262D;
}

.dark-mode .table-row.highlight {
  background: #4D1F1F;
}

.dark-mode .fund-name {
  color: #E6EDF3;
}

.dark-mode .fund-code {
  color: #8B949E;
}

.dark-mode .fund-limit {
  background: #1A4D2E;
  color: #3FB950;
}

.dark-mode .fund-limit.paused {
  background: #4D1F1F;
  color: #F85149;
}

.dark-mode .price-main {
  color: #E6EDF3;
}

.dark-mode .price-sub {
  color: #6E7681;
}

.dark-mode .premium-value {
  color: #3FB950;
}

.dark-mode .premium-value.high {
  color: #F85149;
}

.dark-mode .days-value {
  color: #E6EDF3;
}

.dark-mode .loading {
  background: #0D1117;
}

.dark-mode .loading-spinner {
  border-color: #30363D;
  border-top-color: #58A6FF;
}

.dark-mode .loading-text {
  color: #8B949E;
}