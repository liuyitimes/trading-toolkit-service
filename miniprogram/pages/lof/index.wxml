<view class="container {{isDarkMode ? 'dark-mode' : ''}}">
  <!-- 搜索栏 -->
  <view class="search-bar" wx:if="{{!loading}}">
    <view class="search-box" wx:if="{{showSearch}}">
      <input class="search-input" placeholder="搜索基金名称/代码" value="{{searchKeyword}}" bindinput="onSearchInput" focus="{{showSearch}}" />
      <text class="search-cancel" bindtap="toggleSearch">取消</text>
    </view>
    <view class="search-header" wx:else>
      <text class="page-title">LOF套利</text>
      <view class="header-actions">
        <text class="search-btn" bindtap="toggleSearch">🔍</text>
      </view>
    </view>
  </view>

  <!-- 市场概览 -->
  <view class="market-summary" wx:if="{{!loading && !showSearch}}">
    <view class="summary-header">
      <text class="summary-title">市场概览</text>
      <text class="summary-time">{{updateTime}}</text>
    </view>
    <view class="summary-grid">
      <view class="summary-item">
        <text class="summary-value">{{marketSummary.count}}</text>
        <text class="summary-label">基金数量</text>
      </view>
      <view class="summary-item">
        <text class="summary-value">{{marketSummary.premiumAvg}}{{marketSummary.premiumAvg !== '--' ? '%' : ''}}</text>
        <text class="summary-label">平均溢价</text>
      </view>
      <view class="summary-item">
        <text class="summary-value highlight">{{marketSummary.topPremium}}{{marketSummary.topPremium !== '--' ? '%' : ''}}</text>
        <text class="summary-label">最高溢价</text>
      </view>
      <view class="summary-item">
        <text class="summary-value">{{marketSummary.positiveCount}}/{{marketSummary.count}}</text>
        <text class="summary-label">溢价数</text>
      </view>
      <view class="summary-item">
        <text class="summary-value arbitrage">{{marketSummary.arbitrageCount}}</text>
        <text class="summary-label">可套利</text>
      </view>
      <view class="summary-item">
        <text class="summary-value warn">{{marketSummary.lowLiquidityCount}}</text>
        <text class="summary-label">流动性差</text>
      </view>
    </view>
  </view>

  <!-- Tab分类 -->
  <view class="signal-stats" wx:if="{{!loading && !showSearch}}">
    <view class="stat-item {{currentTab === 'all' ? 'active' : ''}}" bindtap="switchTab" data-tab="all">
      <text class="stat-value">{{tabStats.allCount}}</text>
      <text class="stat-label">全部</text>
    </view>
    <view class="stat-item {{currentTab === 'premium' ? 'active' : ''}}" bindtap="switchTab" data-tab="premium">
      <text class="stat-value highlight">{{tabStats.premiumCount}}</text>
      <text class="stat-label">溢价≥5%</text>
    </view>
    <view class="stat-item {{currentTab === 'discount' ? 'active' : ''}}" bindtap="switchTab" data-tab="discount">
      <text class="stat-value">{{tabStats.discountCount}}</text>
      <text class="stat-label">折价</text>
    </view>
    <view class="stat-item {{currentTab === 'paused' ? 'active' : ''}}" bindtap="switchTab" data-tab="paused">
      <text class="stat-value">{{tabStats.pausedCount}}</text>
      <text class="stat-label">暂停</text>
    </view>
  </view>

  <view class="loading" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <view class="table" wx:if="{{!loading}}">
    <view class="table-header" wx:if="{{!showSearch}}">
      <text class="col-name">名称/代码</text>
      <text class="col-price">价格/涨跌</text>
      <text class="col-premium">溢价率</text>
      <text class="col-volume">成交额</text>
      <text class="col-tags">标记</text>
    </view>

    <view class="table-body">
      <view class="table-row {{item.isHighlight ? 'highlight' : ''}}" wx:for="{{filteredList}}" wx:key="index" bindtap="openLofDetail" data-index="{{index}}" wx:if="{{showSearch}}">
        <view class="col-name">
          <view class="name-row">
            <text class="exchange-icon sh" wx:if="{{item.exchange === '沪'}}">沪</text>
            <text class="exchange-icon sz" wx:elif="{{item.exchange === '深'}}">深</text>
            <text class="fund-name">{{item.name}}</text>
            <text class="fav-icon {{item.isFavorite ? 'active' : ''}}" catchtap="toggleFavorite" data-code="{{item.code}}" data-index="{{index}}">{{item.isFavorite ? '★' : '☆'}}</text>
          </view>
          <view class="code-row">
            <text class="fund-code">{{item.code}}</text>
            <text class="fund-limit {{item.isPaused ? 'paused' : item.limitStatus === '限100' ? 'limited' : ''}}">{{item.limitStatus}}</text>
          </view>
        </view>
        <view class="col-price">
          <text class="price-main">{{item.priceText}}</text>
          <text class="price-sub {{item.isChangeUp ? 'positive' : 'negative'}}">{{item.changePctText}}</text>
        </view>
        <view class="col-premium">
          <text class="premium-value {{item.isHighPremium ? 'high' : ''}}">{{item.premiumText}}</text>
          <text class="premium-sub">{{item.netPremiumText}}</text>
        </view>
        <view class="col-volume">
          <text class="volume-value {{item.amountLevel}}">{{item.amountText}}</text>
        </view>
        <view class="col-tags">
          <text class="tag tag-arbitrage" wx:if="{{item.canArbitrage}}">可套利</text>
          <text class="tag tag-sustained" wx:if="{{item.sustainedPremium}}">溢价持续</text>
          <text class="tag tag-warning" wx:if="{{item.lowLiquidity}}">流动性差</text>
        </view>
      </view>

      <view class="table-row {{item.isHighlight ? 'highlight' : ''}}" wx:for="{{currentList}}" wx:key="index" bindtap="openLofDetail" data-index="{{index}}" wx:if="{{!showSearch}}">
        <view class="col-name">
          <view class="name-row">
            <text class="exchange-icon sh" wx:if="{{item.exchange === '沪'}}">沪</text>
            <text class="exchange-icon sz" wx:elif="{{item.exchange === '深'}}">深</text>
            <text class="fund-name">{{item.name}}</text>
            <text class="fav-icon {{item.isFavorite ? 'active' : ''}}" catchtap="toggleFavorite" data-code="{{item.code}}" data-index="{{index}}">{{item.isFavorite ? '★' : '☆'}}</text>
          </view>
          <view class="code-row">
            <text class="fund-code">{{item.code}}</text>
            <text class="fund-limit {{item.isPaused ? 'paused' : item.limitStatus === '限100' ? 'limited' : ''}}">{{item.limitStatus}}</text>
            <text class="amount-tag {{item.amountLevel}}" wx:if="{{item.amountRaw > 0}}">{{item.amountText}}</text>
          </view>
        </view>
        <view class="col-price">
          <text class="price-main">{{item.priceText}}</text>
          <text class="price-sub {{item.isChangeUp ? 'positive' : 'negative'}}">{{item.changePctText}}</text>
        </view>
        <view class="col-premium">
          <text class="premium-value {{item.isHighPremium ? 'high' : ''}}">{{item.premiumText}}</text>
          <text class="premium-sub {{item.netPremiumClass}}">净{{item.netPremiumText}}</text>
        </view>
        <view class="col-volume">
          <text class="volume-value {{item.amountLevel}}">{{item.amountText}}</text>
        </view>
        <view class="col-tags">
          <text class="tag tag-arbitrage" wx:if="{{item.canArbitrage}}">可套利</text>
          <text class="tag tag-sustained" wx:if="{{item.sustainedPremium}}">溢价持续</text>
          <text class="tag tag-warning" wx:if="{{item.lowLiquidity}}">流动性差</text>
        </view>
      </view>
    </view>
  </view>

  <view class="empty" wx:if="{{showSearch && filteredList.length === 0 && !loading}}">
    <text class="empty-text">未找到匹配的基金</text>
  </view>
  <view class="empty" wx:if="{{!showSearch && currentList.length === 0 && !loading}}">
    <text class="empty-text">暂无数据</text>
  </view>

  <!-- 详情弹窗 -->
  <view class="modal-overlay" wx:if="{{showLofModal && selectedLof}}" bindtap="closeLofModal">
    <view class="modal-content lof-modal" catchtap="">
      <view class="modal-header">
        <text class="modal-title">{{selectedLof.name}} ({{selectedLof.code}})</text>
        <view class="modal-close" bindtap="closeLofModal">×</view>
      </view>
      <view class="modal-body">
        <!-- 基金概要 -->
        <view class="detail-section">
          <text class="detail-section-title">基金概要</text>
          <view class="detail-grid">
            <view class="detail-item">
              <text class="detail-label">交易所</text>
              <text class="detail-value">{{selectedLof.exchange}}</text>
            </view>
            <view class="detail-item">
              <text class="detail-label">申购状态</text>
              <text class="detail-value">{{selectedLof.limitStatus}}</text>
            </view>
            <view class="detail-item">
              <text class="detail-label">申购限额</text>
              <text class="detail-value">{{selectedLof.limitAmount}}</text>
            </view>
            <view class="detail-item">
              <text class="detail-label">赎回规则</text>
              <text class="detail-value">{{selectedLof.isShenzhen ? '深市 T+1可赎' : '沪市 当天可赎'}}</text>
            </view>
          </view>
        </view>

        <!-- 价格与净值 -->
        <view class="detail-section">
          <text class="detail-section-title">价格与净值</text>
          <view class="detail-grid">
            <view class="detail-item highlight-box">
              <text class="detail-label">当前价</text>
              <text class="detail-value">{{selectedLof.price}}</text>
            </view>
            <view class="detail-item highlight-box">
              <text class="detail-label">基金净值</text>
              <text class="detail-value">{{selectedLof.valuation}}</text>
            </view>
            <view class="detail-item highlight-box">
              <text class="detail-label">价格偏离</text>
              <text class="detail-value">{{selectedLof.spread}}</text>
            </view>
            <view class="detail-item highlight-box">
              <text class="detail-label">毛溢价率</text>
              <text class="detail-value highlight">{{selectedLof.premium}}</text>
            </view>
            <view class="detail-item">
              <text class="detail-label">净溢价(扣费后)</text>
              <text class="detail-value highlight">{{selectedLof.netPremium}}</text>
            </view>
          </view>
        </view>

        <!-- 流动性数据 -->
        <view class="detail-section">
          <text class="detail-section-title">流动性数据</text>
          <view class="detail-grid">
            <view class="detail-item">
              <text class="detail-label">成交额</text>
              <text class="detail-value">{{selectedLof.amountText}}</text>
            </view>
            <view class="detail-item">
              <text class="detail-label">成交量</text>
              <text class="detail-value">{{selectedLof.volumeText}}</text>
            </view>
            <view class="detail-item">
              <text class="detail-label">连续溢价</text>
              <text class="detail-value">{{selectedLof.consecutivePremium}}</text>
            </view>
          </view>
        </view>

        <!-- 操作建议 -->
        <view class="detail-section">
          <text class="detail-section-title">操作建议</text>
          <view class="advice-box">
            <text class="advice-text">{{selectedLof.advice}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
