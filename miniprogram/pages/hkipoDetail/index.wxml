<view class="container {{isDarkMode ? 'dark-mode' : ''}}">
  <view class="loading-overlay" wx:if="{{loading}}">
    <view class="loading-content">
      <view class="loading-spinner"></view>
      <text class="loading-text">加载中...</text>
    </view>
  </view>

  <view class="empty-state" wx:if="{{!loading && !detail}}">
    <text class="empty-icon">📭</text>
    <text class="empty-text">未找到该新股信息</text>
    <button class="back-btn" bindtap="goBack">返回</button>
  </view>

  <view class="detail-content" wx:if="{{!loading && detail}}">
    <!-- 顶部信息 -->
    <view class="detail-header">
      <view class="header-top">
        <view class="header-left">
          <view class="name-row">
            <text class="exchange-icon hk">港</text>
            <text class="detail-name">{{detail.name}}</text>
          </view>
          <text class="detail-code">{{detail.code}} · {{detail.industry}}</text>
        </view>
        <view class="header-right">
          <view class="status-tag {{detail.status === '已上市' ? 'listed' : detail.status === '申购中' ? 'subscribing' : 'pending'}}">
            {{detail.status}}
          </view>
        </view>
      </view>
      <view class="header-actions">
        <view class="action-btn {{isFavorite ? 'active' : ''}}" bindtap="toggleFavorite">
          <text>{{isFavorite ? '★ 已自选' : '☆ 自选'}}</text>
        </view>
        <view class="action-btn {{subscribed ? 'active' : ''}}" bindtap="toggleSubscribe" wx:if="{{detail.status === '申购中'}}">
          <text>{{subscribed ? '✓ 已申购' : '标记申购'}}</text>
        </view>
        <view class="action-btn {{won ? 'won' : ''}}" bindtap="toggleWin" wx:if="{{detail.status === '中签公布'}}">
          <text>{{won ? '🎉 已中签' : '标记中签'}}</text>
        </view>
      </view>
    </view>

    <!-- 基本信息 -->
    <view class="section">
      <text class="section-title">基本信息</text>
      <view class="info-grid">
        <view class="info-item">
          <text class="info-label">发行价</text>
          <text class="info-value">{{detail.ipoPrice}} HKD</text>
        </view>
        <view class="info-item">
          <text class="info-label">每手股数</text>
          <text class="info-value">{{detail.lotSize}}</text>
        </view>
        <view class="info-item">
          <text class="info-label">发行规模</text>
          <text class="info-value">{{detail.issueSize}}</text>
        </view>
        <view class="info-item">
          <text class="info-label">市盈率</text>
          <text class="info-value">{{detail.peRatio}}</text>
        </view>
        <view class="info-item">
          <text class="info-label">申购截止</text>
          <text class="info-value">{{detail.applyEndDate}}</text>
        </view>
        <view class="info-item">
          <text class="info-label">上市日期</text>
          <text class="info-value">{{detail.listDate}}</text>
        </view>
      </view>
    </view>

    <!-- 发行流程时间线 -->
    <view class="section" wx:if="{{detail.hasTimeline}}">
      <text class="section-title">发行流程</text>
      <scroll-view scroll-x class="timeline-scroll" enable-flex>
        <view class="timeline">
          <view class="timeline-node {{item.done ? 'done' : ''}} {{item.current ? 'current' : ''}}" wx:for="{{detail.timeline}}" wx:key="step">
            <view class="node-dot">
              <text class="node-icon" wx:if="{{item.done}}">✓</text>
              <text class="node-num" wx:elif="{{item.current}}">{{index + 1}}</text>
            </view>
            <text class="node-step">{{item.step}}</text>
            <text class="node-date">{{item.date}}</text>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- 认购数据 -->
    <view class="section" wx:if="{{detail.hasOversub}}">
      <text class="section-title">认购数据</text>
      <view class="info-grid">
        <view class="info-item">
          <text class="info-label">超额认购</text>
          <text class="info-value {{detail.isHighOversubscription ? 'highlight' : ''}}">{{detail.oversubscriptionText}}</text>
        </view>
        <view class="info-item">
          <text class="info-label">孖展认购额</text>
          <text class="info-value">{{detail.marginTotal}}</text>
        </view>
        <view class="info-item">
          <text class="info-label">公开认购</text>
          <text class="info-value">{{detail.publicOversub}}</text>
        </view>
        <view class="info-item">
          <text class="info-label">国际配售</text>
          <text class="info-value">{{detail.intlOversub}}</text>
        </view>
      </view>
    </view>

    <!-- 暗盘行情 -->
    <view class="section" wx:if="{{detail.hasDark}}">
      <text class="section-title">暗盘行情</text>
      <view class="info-grid">
        <view class="info-item">
          <text class="info-label">暗盘价</text>
          <text class="info-value">{{detail.darkPrice}}</text>
        </view>
        <view class="info-item">
          <text class="info-label">暗盘涨跌</text>
          <text class="info-value {{detail.darkChangeNum >= 0 ? 'up' : 'down'}}">{{detail.darkChange}}</text>
        </view>
        <view class="info-item">
          <text class="info-label">暗盘时间</text>
          <text class="info-value">{{detail.darkTime}}</text>
        </view>
      </view>
    </view>

    <!-- 配售结果 -->
    <view class="section" wx:if="{{detail.hasWinRate}}">
      <text class="section-title">配售结果</text>
      <view class="info-grid">
        <view class="info-item">
          <text class="info-label">一手中签率</text>
          <text class="info-value">{{detail.winRate}}</text>
        </view>
        <view class="info-item">
          <text class="info-label">申购倍数</text>
          <text class="info-value">{{detail.applyMultiple}}</text>
        </view>
        <view class="info-item">
          <text class="info-label">回拨比例</text>
          <text class="info-value">{{detail.clawbackRatio}}</text>
        </view>
      </view>
    </view>

    <!-- 上市表现 -->
    <view class="section" wx:if="{{detail.hasListPerf}}">
      <text class="section-title">上市表现</text>
      <view class="info-grid">
        <view class="info-item">
          <text class="info-label">首日开盘</text>
          <text class="info-value">{{detail.openPrice}}</text>
        </view>
        <view class="info-item">
          <text class="info-label">首日收盘</text>
          <text class="info-value">{{detail.closePrice}}</text>
        </view>
        <view class="info-item">
          <text class="info-label">首日涨跌</text>
          <text class="info-value {{detail.changePctNum >= 0 ? 'up' : 'down'}}">{{detail.changePct}}</text>
        </view>
        <view class="info-item">
          <text class="info-label">累计涨跌</text>
          <text class="info-value {{detail.totalChangeNum >= 0 ? 'up' : 'down'}}">{{detail.totalChange}}</text>
        </view>
      </view>
    </view>

    <!-- 券商孖展 -->
    <view class="section" wx:if="{{detail.hasMargin}}">
      <text class="section-title">券商孖展</text>
      <view class="margin-summary">
        <view class="margin-sum-item">
          <text class="margin-sum-label">总孖展额</text>
          <text class="margin-sum-value">{{detail.marginTotalAmount}}</text>
        </view>
        <view class="margin-sum-item">
          <text class="margin-sum-label">超额倍数</text>
          <text class="margin-sum-value">{{detail.marginMultiple}}</text>
        </view>
      </view>
      <view class="margin-list">
        <view class="margin-header">
          <text class="margin-col-name">券商</text>
          <text class="margin-col-amount">孖展金额</text>
          <text class="margin-col-ratio">占比</text>
        </view>
        <view class="margin-row" wx:for="{{detail.marginList}}" wx:key="broker">
          <text class="margin-col-name">{{item.broker || '--'}}</text>
          <text class="margin-col-amount">{{item.amount ? item.amount.toFixed(2) + '亿' : '--'}}</text>
          <text class="margin-col-ratio">{{item.ratio ? item.ratio.toFixed(1) + '%' : '--'}}</text>
        </view>
      </view>
    </view>

    <!-- 无孖展数据 -->
    <view class="section" wx:if="{{!detail.hasMargin}}">
      <text class="section-title">券商孖展</text>
      <view class="no-data">
        <text class="no-data-text">暂无孖展数据</text>
      </view>
    </view>
  </view>
</view>
