/* ==================== 港股打新详情页 ==================== */
.container {
  min-height: 100vh;
  background: #F6F8FA;
  padding-bottom: 60rpx;
}

/* ==================== 加载与空状态 ==================== */
.loading-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: #F6F8FA;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.loading-content { text-align: center; }

.loading-spinner {
  width: 48rpx; height: 48rpx;
  border: 3rpx solid #D0D7DE;
  border-top-color: #0969DA;
  border-radius: 50%;
  animation: spin 0.6s linear infinite;
  margin: 0 auto 16rpx;
}

@keyframes spin { to { transform: rotate(360deg); } }

.loading-text { font-size: 28rpx; color: #59636E; }

.empty-state {
  text-align: center;
  padding: 200rpx 40rpx;
}

.empty-icon { font-size: 100rpx; display: block; margin-bottom: 24rpx; opacity: 0.4; }
.empty-text { font-size: 28rpx; color: #818B98; display: block; margin-bottom: 32rpx; }
.back-btn {
  background: #0969DA; color: #fff; border-radius: 8rpx;
  padding: 16rpx 48rpx; font-size: 28rpx; display: inline-block;
}

/* ==================== 顶部信息 ==================== */
.detail-header {
  background: #FFFFFF;
  padding: 32rpx;
  border-bottom: 1rpx solid #D0D7DE;
}

.header-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.exchange-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 36rpx; height: 36rpx;
  border-radius: 6rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: #fff;
}

.exchange-icon.hk { background: #0969DA; }

.detail-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #1F2328;
}

.detail-code {
  font-size: 24rpx;
  color: #818B98;
}

.status-tag {
  font-size: 22rpx;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

.status-tag.listed { background: #DAFBE1; color: #1A7F37; border: 1rpx solid #4AC26B; }
.status-tag.subscribing { background: #FFEBE9; color: #CF222E; border: 1rpx solid #FFCECB; }
.status-tag.pending { background: #FFF8E5; color: #9A6700; border: 1rpx solid #D4A72C; }

.header-actions {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  background: #F6F8FA;
  border: 1rpx solid #D0D7DE;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #59636E;
}

.action-btn.active {
  background: #EBF5FF;
  border-color: #0969DA;
  color: #0969DA;
}

.action-btn.won {
  background: #DAFBE1;
  border-color: #4AC26B;
  color: #1A7F37;
}

/* ==================== 通用区域 ==================== */
.section {
  background: #FFFFFF;
  margin: 20rpx 20rpx 0;
  border: 1rpx solid #D0D7DE;
  border-radius: 12rpx;
  padding: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1F2328;
  display: block;
  margin-bottom: 20rpx;
}

.section-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.section-title-row .section-title {
  margin-bottom: 0;
}

.section-badge {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  background: #EBF5FF;
  color: #0969DA;
  border: 1rpx solid #58A6FF;
  font-weight: 500;
}

/* ==================== 信息网格 ==================== */
.info-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 0;
}

.info-item {
  width: 50%;
  padding: 12rpx 0;
  box-sizing: border-box;
}

.info-label {
  font-size: 22rpx;
  color: #818B98;
  display: block;
  margin-bottom: 4rpx;
}

.info-value {
  font-size: 28rpx;
  font-weight: 600;
  color: #1F2328;
}

.info-value.up { color: #CF222E; }
.info-value.down { color: #1A7F37; }
.info-value.highlight { color: #CF222E; font-weight: 700; }

/* ==================== 时间线 ==================== */
.timeline-scroll {
  white-space: nowrap;
}

.timeline {
  display: flex;
  padding: 16rpx 0;
}

.timeline-node {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 140rpx;
  position: relative;
}

.timeline-node::after {
  content: '';
  position: absolute;
  top: 20rpx;
  left: 50%;
  width: 100%;
  height: 2rpx;
  background: #D0D7DE;
  z-index: 0;
}

.timeline-node:last-child::after { display: none; }
.timeline-node.done::after { background: #4AC26B; }

.node-dot {
  width: 40rpx; height: 40rpx;
  border-radius: 50%;
  background: #D0D7DE;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1;
  margin-bottom: 8rpx;
}

.timeline-node.done .node-dot { background: #4AC26B; }
.timeline-node.current .node-dot { background: #0969DA; }

.node-icon { font-size: 20rpx; color: #fff; }
.node-num { font-size: 18rpx; color: #fff; font-weight: 700; }
.node-step { font-size: 22rpx; color: #59636E; margin-bottom: 4rpx; }
.node-date { font-size: 20rpx; color: #818B98; }

.timeline-node.done .node-step { color: #1A7F37; }
.timeline-node.current .node-step { color: #0969DA; font-weight: 600; }

.current-tag {
  font-size: 18rpx;
  padding: 2rpx 12rpx;
  border-radius: 10rpx;
  background: #0969DA;
  color: #fff;
  font-weight: 600;
  margin-top: 4rpx;
  animation: pulse-tag 2s ease-in-out infinite;
}

@keyframes pulse-tag {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.7; transform: scale(1.05); }
}

/* ==================== 券商孖展 ==================== */
.margin-summary {
  display: flex;
  gap: 32rpx;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #D0D7DE;
}

.margin-sum-item { flex: 1; }
.margin-sum-label { font-size: 22rpx; color: #818B98; display: block; }
.margin-sum-value { font-size: 32rpx; font-weight: 700; color: #1F2328; }

.margin-header, .margin-row {
  display: flex;
  padding: 12rpx 0;
}

.margin-header {
  border-bottom: 1rpx solid #D0D7DE;
  margin-bottom: 8rpx;
}

.margin-header text {
  font-size: 22rpx;
  color: #818B98;
  font-weight: 600;
}

.margin-row {
  border-bottom: 1rpx solid #F0F0F0;
}

.margin-row:last-child { border-bottom: none; }

.margin-row text {
  font-size: 24rpx;
  color: #1F2328;
}

.margin-col-name { flex: 2; }
.margin-col-amount { flex: 2; text-align: right; font-weight: 600; }
.margin-col-ratio { flex: 1; text-align: right; color: #59636E; }

.no-data {
  text-align: center;
  padding: 40rpx 0;
}

.no-data-text {
  font-size: 24rpx;
  color: #818B98;
}

/* ==================== 暗夜模式 ==================== */
.dark-mode .container { background: #0D1117; }
.dark-mode .loading-overlay { background: #0D1117; }
.dark-mode .loading-spinner { border-color: #30363D; border-top-color: #58A6FF; }
.dark-mode .loading-text { color: #8B949E; }
.dark-mode .empty-state { background: #0D1117; }
.dark-mode .empty-text { color: #6E7681; }

.dark-mode .detail-header { background: #161B22; border-color: #30363D; }
.dark-mode .detail-name { color: #E6EDF3; }
.dark-mode .detail-code { color: #6E7681; }

.dark-mode .status-tag.listed { background: #1A4D2E; color: #3FB950; border-color: #238636; }
.dark-mode .status-tag.subscribing { background: #4D1F1F; color: #F85149; border-color: #DA3633; }
.dark-mode .status-tag.pending { background: #3D2E00; color: #D29922; border-color: #9E6A03; }

.dark-mode .action-btn { background: #21262D; border-color: #30363D; color: #8B949E; }
.dark-mode .action-btn.active { background: #0D2240; border-color: #58A6FF; color: #58A6FF; }
.dark-mode .action-btn.won { background: #1A4D2E; border-color: #238636; color: #3FB950; }

.dark-mode .section { background: #161B22; border-color: #30363D; }
.dark-mode .section-title { color: #E6EDF3; }
.dark-mode .info-label { color: #6E7681; }
.dark-mode .info-value { color: #E6EDF3; }
.dark-mode .info-value.up { color: #F85149; }
.dark-mode .info-value.down { color: #3FB950; }
.dark-mode .info-value.highlight { color: #F85149; }

.dark-mode .node-dot { background: #30363D; }
.dark-mode .timeline-node.done .node-dot { background: #238636; }
.dark-mode .timeline-node.current .node-dot { background: #58A6FF; }
.dark-mode .node-step { color: #8B949E; }
.dark-mode .node-date { color: #6E7681; }
.dark-mode .timeline-node.done .node-step { color: #3FB950; }
.dark-mode .timeline-node.current .node-step { color: #58A6FF; }
.dark-mode .timeline-node::after { background: #30363D; }
.dark-mode .timeline-node.done::after { background: #238636; }

.dark-mode .section-badge { background: #0D2240; color: #58A6FF; border-color: #58A6FF; }
.dark-mode .current-tag { background: #58A6FF; color: #fff; }

.dark-mode .margin-summary { border-color: #30363D; }
.dark-mode .margin-sum-label { color: #6E7681; }
.dark-mode .margin-sum-value { color: #E6EDF3; }
.dark-mode .margin-header { border-color: #30363D; }
.dark-mode .margin-header text { color: #6E7681; }
.dark-mode .margin-row { border-color: #21262D; }
.dark-mode .margin-row text { color: #E6EDF3; }
.dark-mode .margin-col-ratio text { color: #8B949E; }
.dark-mode .no-data-text { color: #6E7681; }
