/* ==================== 设置页面样式 ==================== */
.container {
  min-height: 100vh;
  background: #F6F8FA;
  padding-bottom: env(safe-area-inset-bottom);
}

/* ==================== 页面标题 ==================== */
.page-header {
  padding: 32rpx 32rpx 24rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1F2328;
}

/* ==================== 分区卡片 ==================== */
.section {
  background: #FFFFFF;
  border-radius: 16rpx;
  margin: 0 24rpx 24rpx;
  overflow: hidden;
  box-shadow: 0 1rpx 3rpx rgba(31, 35, 40, 0.04);
}

.section-header {
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid #EAEef2;
}

.section-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.section-icon {
  font-size: 32rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2328;
}

.section-actions {
  margin-left: auto;
}

.action-text {
  font-size: 26rpx;
  color: #0969DA;
  font-weight: 500;
}

.section-body {
  padding: 0;
}

/* ==================== 设置行 ==================== */
.setting-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 28rpx;
  min-height: 88rpx;
}

.setting-row.border-top {
  border-top: 1rpx solid #EAEef2;
}

.setting-row.clickable:active {
  background: #F6F8FA;
}

.setting-left {
  flex: 1;
}

.setting-label {
  font-size: 30rpx;
  color: #1F2328;
  font-weight: 400;
}

.setting-label.danger {
  color: #CF222E;
}

.setting-hint {
  font-size: 24rpx;
  color: #818B98;
  margin-top: 4rpx;
  display: block;
}

.setting-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.setting-value-text {
  font-size: 28rpx;
  color: #818B98;
}

.arrow {
  font-size: 28rpx;
  color: #C4CDD5;
  font-weight: 600;
}

/* ==================== 主题选择器 ==================== */
.theme-selector {
  display: flex;
  gap: 20rpx;
}

.theme-option {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 20rpx;
  border: 2rpx solid #D0D7DE;
  border-radius: 12rpx;
  transition: all 0.2s;
}

.theme-option.active {
  border-color: #2DA44E;
  background: #F6F8FA;
}

.theme-preview {
  width: 72rpx;
  height: 48rpx;
  border-radius: 6rpx;
  border: 1rpx solid #D0D7DE;
}

.light-preview {
  background: linear-gradient(135deg, #FFFFFF 50%, #F6F8FA 50%);
}

.dark-preview {
  background: linear-gradient(135deg, #1F2328 50%, #0D1117 50%);
}

.theme-name {
  font-size: 22rpx;
  color: #1F2328;
}

/* ==================== 名言卡片 ==================== */
.quote-list {
  padding: 0;
}

.quote-card {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid #EAEef2;
}

.quote-card:last-child {
  border-bottom: none;
}

.quote-content {
  flex: 1;
  padding-right: 20rpx;
}

.quote-text {
  display: block;
  font-size: 28rpx;
  color: #1F2328;
  line-height: 1.6;
  margin-bottom: 8rpx;
}

.quote-author {
  display: block;
  font-size: 24rpx;
  color: #818B98;
}

.quote-actions {
  display: flex;
  gap: 16rpx;
  flex-shrink: 0;
}

.icon-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F6F8FA;
  border-radius: 10rpx;
  font-size: 28rpx;
}

.icon-btn.delete {
  background: #FFEBE9;
}

.icon-btn.danger {
  background: #FFEBE9;
  color: #CF222E;
  font-size: 24rpx;
  width: auto;
  padding: 0 24rpx;
  height: 56rpx;
}

.icon-btn-large {
  padding: 12rpx 32rpx;
  background: #F6F8FA;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #59636E;
}

.icon-btn-large.danger {
  background: #FFEBE9;
  color: #CF222E;
}

/* ==================== 添加按钮 ==================== */
.add-quote-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 24rpx;
  border-top: 1rpx solid #EAEef2;
  background: #FAFBFC;
}

.add-quote-btn:active {
  background: #F0F2F5;
}

.add-icon {
  font-size: 32rpx;
  color: #0969DA;
  font-weight: 500;
}

.add-text {
  font-size: 28rpx;
  color: #0969DA;
  font-weight: 500;
}

/* ==================== URL输入 ==================== */
.url-input {
  width: 100%;
  padding: 20rpx;
  background: #F6F8FA;
  border: 1rpx solid #D0D7DE;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #1F2328;
  margin-top: 12rpx;
}

.url-input.error {
  border-color: #CF222E;
}

.input-error {
  font-size: 24rpx;
  color: #CF222E;
  margin-top: 8rpx;
  display: block;
}

.input-hint {
  font-size: 24rpx;
  color: #818B98;
  margin-top: 8rpx;
  display: block;
}

/* ==================== 关于信息 ==================== */
.about-info {
  padding: 8rpx 0;
}

.about-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 28rpx;
  border-bottom: 1rpx solid #EAEef2;
}

.about-row:last-child {
  border-bottom: none;
}

.about-label {
  font-size: 28rpx;
  color: #59636E;
}

.about-value {
  font-size: 28rpx;
  color: #1F2328;
}

/* ==================== 底部留白 ==================== */
.bottom-space {
  height: 60rpx;
}

/* ==================== 模态框 ==================== */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(31, 35, 40, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.quote-modal {
  width: 90%;
  max-width: 640rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  overflow: hidden;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 32rpx 24rpx;
  border-bottom: 1rpx solid #EAEef2;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1F2328;
}

.modal-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #818B98;
}

.modal-body {
  padding: 32rpx;
}

.form-group {
  margin-bottom: 28rpx;
}

.form-group:last-child {
  margin-bottom: 0;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: #59636E;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.form-textarea {
  width: 100%;
  height: 200rpx;
  padding: 20rpx;
  background: #F6F8FA;
  border: 1rpx solid #D0D7DE;
  border-radius: 10rpx;
  font-size: 28rpx;
  color: #1F2328;
  line-height: 1.6;
  box-sizing: border-box;
}

.char-count {
  font-size: 22rpx;
  color: #818B98;
  text-align: right;
  margin-top: 8rpx;
  display: block;
}

.form-input {
  width: 100%;
  padding: 20rpx;
  background: #F6F8FA;
  border: 1rpx solid #D0D7DE;
  border-radius: 10rpx;
  font-size: 28rpx;
  color: #1F2328;
  box-sizing: border-box;
}

.modal-footer {
  display: flex;
  border-top: 1rpx solid #EAEef2;
}

.modal-btn {
  flex: 1;
  padding: 28rpx;
  font-size: 30rpx;
  border-radius: 0;
  font-weight: 500;
  line-height: 1.2;
}

.modal-btn.cancel {
  background: #FFFFFF;
  color: #59636E;
  border-right: 1rpx solid #EAEef2;
}

.modal-btn.confirm {
  background: #2DA44E;
  color: #FFFFFF;
}

/* ==================== 暗夜模式覆盖 ==================== */
.dark-mode {
  background: #0D1117;
}

.dark-mode .page-title {
  color: #E6EDF3;
}

.dark-mode .section {
  background: #161B22;
}

.dark-mode .section-header {
  border-color: #30363D;
}

.dark-mode .section-title {
  color: #E6EDF3;
}

.dark-mode .setting-row {
  border-color: #30363D;
}

.dark-mode .setting-label {
  color: #E6EDF3;
}

.dark-mode .setting-hint {
  color: #8B949E;
}

.dark-mode .setting-value-text {
  color: #8B949E;
}

.dark-mode .arrow {
  color: #484F58;
}

.dark-mode .theme-option {
  border-color: #30363D;
}

.dark-mode .theme-option.active {
  background: #0D1117;
}

.dark-mode .theme-name {
  color: #E6EDF3;
}

.dark-mode .quote-card {
  border-color: #30363D;
}

.dark-mode .quote-text {
  color: #E6EDF3;
}

.dark-mode .quote-author {
  color: #8B949E;
}

.dark-mode .icon-btn {
  background: #21262D;
}

.dark-mode .icon-btn.delete {
  background: #4D1F1F;
}

.dark-mode .add-quote-btn {
  background: #0D1117;
  border-color: #30363D;
}

.dark-mode .add-quote-btn:active {
  background: #161B22;
}

.dark-mode .add-icon,
.dark-mode .add-text {
  color: #58A6FF;
}

.dark-mode .url-input {
  background: #0D1117;
  border-color: #30363D;
  color: #E6EDF3;
}

.dark-mode .url-input.error {
  border-color: #F85149;
}

.dark-mode .input-hint {
  color: #6E7681;
}

.dark-mode .input-error {
  color: #F85149;
}

.dark-mode .about-row {
  border-color: #30363D;
}

.dark-mode .about-label {
  color: #8B949E;
}

.dark-mode .about-value {
  color: #E6EDF3;
}

.dark-mode .icon-btn-large {
  background: #21262D;
  color: #8B949E;
}

.dark-mode .icon-btn-large.danger {
  background: #4D1F1F;
  color: #F85149;
}

.dark-mode .quote-modal {
  background: #161B22;
}

.dark-mode .modal-header {
  border-color: #30363D;
}

.dark-mode .modal-title {
  color: #E6EDF3;
}

.dark-mode .modal-close {
  color: #8B949E;
}

.dark-mode .form-textarea,
.dark-mode .form-input {
  background: #0D1117;
  border-color: #30363D;
  color: #E6EDF3;
}

.dark-mode .form-label {
  color: #8B949E;
}

.dark-mode .modal-btn.cancel {
  background: #161B22;
  color: #8B949E;
  border-color: #30363D;
}

.dark-mode .modal-btn.confirm {
  background: #2EA043;
}
