<view class="container {{isDarkMode ? 'dark-mode' : ''}}">
  <!-- 页面头部 -->
  <view class="page-header">
    <view class="header-left" bindtap="goBack">
      <text class="back-icon">‹</text>
      <text class="back-text">返回</text>
    </view>
    <text class="page-title">名言管理</text>
    <view class="header-right" bindtap="goBack">
      <text class="done-text">完成</text>
    </view>
  </view>

  <!-- 名言列表 -->
  <view class="quote-list">
    <view class="quote-card" wx:for="{{quotes}}" wx:key="index">
      <view class="quote-content" bindtap="editQuote" data-index="{{index}}">
        <text class="quote-text">"{{item.text}}"</text>
        <text class="quote-author">—— {{item.author}}</text>
      </view>
      <view class="quote-actions">
        <view class="action-btn" bindtap="editQuote" data-index="{{index}}">
          <text class="action-icon">✏️</text>
        </view>
        <view class="action-btn delete" bindtap="deleteQuote" data-index="{{index}}">
          <text class="action-icon">🗑️</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 添加按钮 -->
  <view class="add-section">
    <view class="add-btn" bindtap="addQuote">
      <text class="add-icon">+</text>
      <text class="add-text">添加新名言</text>
    </view>
    <view class="reset-btn" bindtap="resetQuotes">
      <text class="reset-text">恢复默认</text>
    </view>
  </view>

  <!-- 底部留白 -->
  <view class="bottom-space"></view>
</view>

<!-- 编辑弹窗 -->
<view class="modal-overlay" wx:if="{{showEditModal}}" bindtap="closeModal">
  <view class="edit-modal" catchtap="stopPropagation">
    <view class="modal-header">
      <text class="modal-title">{{isEditing ? '编辑名言' : '添加名言'}}</text>
      <view class="modal-close" bindtap="closeModal">×</view>
    </view>
    <view class="modal-body">
      <view class="form-group">
        <text class="form-label">名言内容</text>
        <textarea class="form-textarea" placeholder="请输入名言内容" value="{{editText}}" bindinput="onTextInput" maxlength="200"></textarea>
        <text class="char-count">{{editText.length}}/200</text>
      </view>
      <view class="form-group">
        <text class="form-label">作者（可选）</text>
        <input class="form-input" placeholder="请输入作者" value="{{editAuthor}}" bindinput="onAuthorInput" />
      </view>
    </view>
    <view class="modal-footer">
      <button class="modal-btn cancel" bindtap="closeModal">取消</button>
      <button class="modal-btn confirm" bindtap="saveQuote">保存</button>
    </view>
  </view>
</view>
