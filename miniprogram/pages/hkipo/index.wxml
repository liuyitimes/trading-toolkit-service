<view class="container {{isDarkMode ? 'dark-mode' : ''}}">
  <!-- 搜索栏 -->
  <view class="search-bar" wx:if="{{!loading}}">
    <view class="search-box" wx:if="{{showSearch}}">
      <input class="search-input" placeholder="搜索新股名称/代码" value="{{searchKeyword}}" bindinput="onSearchInput" focus="{{showSearch}}" />
      <text class="search-cancel" bindtap="toggleSearch">取消</text>
    </view>
    <view class="search-header" wx:else>
      <text class="page-title">港股打新</text>
      <view class="header-actions">
        <text class="search-btn" bindtap="toggleSearch">🔍</text>
      </view>
    </view>
  </view>

  <view class="tabs" wx:if="{{!loading && !showSearch}}">
    <scroll-view scroll-x class="tabs-scroll">
      <view class="tab {{currentTab === 'all' ? 'active' : ''}}" bindtap="switchTab" data-tab="all">全部</view>
      <view class="tab {{currentTab === 'upcoming' ? 'active' : ''}}" bindtap="switchTab" data-tab="upcoming">申购中</view>
      <view class="tab {{currentTab === 'pending' ? 'active' : ''}}" bindtap="switchTab" data-tab="pending">待上市</view>
      <view class="tab {{currentTab === 'listed' ? 'active' : ''}}" bindtap="switchTab" data-tab="listed">已上市</view>
      <view class="tab {{currentTab === 'darkpool' ? 'active' : ''}}" bindtap="switchTab" data-tab="darkpool">暗盘中</view>
    </scroll-view>
  </view>

  <!-- 暗盘行情卡片 -->
  <view class="dark-pool-section" wx:if="{{!loading && darkPoolList.length > 0}}">
    <view class="dp-header">
      <text class="dp-title">暗盘行情</text>
      <text class="dp-subtitle">暗盘交易中的新股</text>
    </view>
    <scroll-view scroll-x class="dp-scroll">
      <view class="dp-card" wx:for="{{darkPoolList}}" wx:key="code" bindtap="goToDetail" data-code="{{item.code}}">
        <view class="dp-card-top">
          <text class="dp-name">{{item.name}}</text>
          <text class="dp-code">{{item.code}}</text>
        </view>
        <view class="dp-card-body">
          <view class="dp-row">
            <text class="dp-label">暗盘价</text>
            <text class="dp-val">{{item.dark_price || '--'}}</text>
          </view>
          <view class="dp-row">
            <text class="dp-label">发行价</text>
            <text class="dp-val">{{item.ipo_price || '--'}}</text>
          </view>
          <view class="dp-row">
            <text class="dp-label">涨跌幅</text>
            <text class="dp-val {{item.dark_change >= 0 ? 'dp-up' : 'dp-down'}}">{{item.dark_change != null ? ((item.dark_change >= 0 ? '+' : '') + item.dark_change.toFixed(2) + '%') : '--'}}</text>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 暗盘空状态 -->
  <view class="dark-pool-empty" wx:if="{{!loading && darkPoolList.length === 0 && currentTab === 'all'}}">
    <text class="dp-empty-text">暂无暗盘数据</text>
  </view>

  <view class="loading-overlay" wx:if="{{loading}}">
    <view class="loading-content">
      <view class="loading-spinner"></view>
      <text class="loading-text">加载中...</text>
    </view>
  </view>

  <view class="content" wx:if="{{!loading}}">
    <view class="ipo-list" wx:if="{{showSearch && filteredList.length > 0}}">
      <view class="ipo-item" wx:for="{{filteredList}}" wx:key="index" bindtap="goToDetail" data-code="{{item.code}}">
        <view class="ipo-header">
          <view class="ipo-title">
            <text class="exchange-icon hk">港</text>
            <text class="ipo-name">{{item.name}}</text>
            <text class="ipo-code">{{item.code}}</text>
            <text class="fav-icon {{item.isFavorite ? 'active' : ''}}" catchtap="toggleFavorite" data-code="{{item.code}}" data-index="{{index}}">{{item.isFavorite ? '★' : '☆'}}</text>
          </view>
          <view class="ipo-status {{item.status === '已上市' ? 'listed' : item.status === '申购中' ? 'subscribing' : 'pending'}}">
            {{item.status}}
          </view>
        </view>
        <view class="ipo-body">
          <view class="ipo-col">
            <text class="ipo-label">发行价</text>
            <text class="ipo-value">{{item.ipo_price}} HKD</text>
          </view>
          <view class="ipo-col">
            <text class="ipo-label">{{item.apply_end_date ? '截止日' : (item.list_date ? '上市日' : '每手股数')}}</text>
            <text class="ipo-value">{{item.apply_end_date || item.list_date || item.lot_size}}</text>
          </view>
          <view class="ipo-col" wx:if="{{item.showChange}}">
            <text class="ipo-label">涨跌幅</text>
            <text class="ipo-value {{item.isUp ? 'up' : 'down'}}">{{item.change_pct}}</text>
          </view>
          <view class="ipo-col" wx:if="{{item.oversubscription}}">
            <text class="ipo-label">超额认购</text>
            <text class="ipo-value {{item.isHighOversubscription ? 'highlight' : ''}}">{{item.oversubscriptionText}}</text>
          </view>
          <view class="ipo-col" wx:if="{{item.showDarkPool}}">
            <text class="ipo-label">暗盘</text>
            <text class="ipo-value {{item.darkPoolIsUp ? 'dp-up' : 'dp-down'}}">{{item.darkPoolChangeText}}</text>
          </view>
        </view>
      </view>
    </view>
    <view class="ipo-list" wx:if="{{!showSearch && currentList.length > 0}}">
      <view class="ipo-item" wx:for="{{currentList}}" wx:key="index" bindtap="goToDetail" data-code="{{item.code}}">
        <view class="ipo-header">
          <view class="ipo-title">
            <text class="exchange-icon hk">港</text>
            <text class="ipo-name">{{item.name}}</text>
            <text class="ipo-code">{{item.code}}</text>
            <text class="fav-icon {{item.isFavorite ? 'active' : ''}}" catchtap="toggleFavorite" data-code="{{item.code}}" data-index="{{index}}">{{item.isFavorite ? '★' : '☆'}}</text>
          </view>
          <view class="ipo-status {{item.status === '已上市' ? 'listed' : item.status === '申购中' ? 'subscribing' : 'pending'}}">
            {{item.status}}
          </view>
        </view>
        <view class="ipo-body">
          <view class="ipo-col">
            <text class="ipo-label">发行价</text>
            <text class="ipo-value">{{item.ipo_price}} HKD</text>
          </view>
          <view class="ipo-col">
            <text class="ipo-label">{{item.apply_end_date ? '截止日' : (item.list_date ? '上市日' : '每手股数')}}</text>
            <text class="ipo-value">{{item.apply_end_date || item.list_date || item.lot_size}}</text>
          </view>
          <view class="ipo-col" wx:if="{{item.showChange}}">
            <text class="ipo-label">涨跌幅</text>
            <text class="ipo-value {{item.isUp ? 'up' : 'down'}}">{{item.change_pct}}</text>
          </view>
          <view class="ipo-col" wx:if="{{item.oversubscription}}">
            <text class="ipo-label">超额认购</text>
            <text class="ipo-value {{item.isHighOversubscription ? 'highlight' : ''}}">{{item.oversubscriptionText}}</text>
          </view>
          <view class="ipo-col" wx:if="{{item.showDarkPool}}">
            <text class="ipo-label">暗盘</text>
            <text class="ipo-value {{item.darkPoolIsUp ? 'dp-up' : 'dp-down'}}">{{item.darkPoolChangeText}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="empty" wx:if="{{showSearch && filteredList.length === 0}}">
      <text class="empty-icon">📭</text>
      <text class="empty-text">未找到匹配的新股</text>
    </view>
    <view class="empty" wx:if="{{!showSearch && currentList.length === 0}}">
      <text class="empty-icon">📭</text>
      <text class="empty-text">暂无IPO数据</text>
    </view>
  </view>
</view>
