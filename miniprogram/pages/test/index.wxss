/* ==================== 接口测试页面样式 ==================== */
.container {
  min-height: 100vh;
  background: #F6F8FA;
  padding-bottom: 40rpx;
}

.header {
  background: #FFFFFF;
  padding: 32rpx;
  border-bottom: 1rpx solid #D0D7DE;
}

.title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1F2328;
  display: block;
}

.subtitle {
  font-size: 26rpx;
  color: #656D76;
  margin-top: 8rpx;
  display: block;
}

.summary-card {
  margin: 24rpx;
  background: #FFFFFF;
  border: 1rpx solid #D0D7DE;
  border-radius: 8rpx;
  padding: 24rpx;
}

.summary-row {
  display: flex;
  justify-content: space-around;
}

.summary-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.summary-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #1F2328;
}

.summary-value.pass {
  color: #1A7F37;
}

.summary-value.fail {
  color: #CF222E;
}

.summary-value.error {
  color: #9A6700;
}

.summary-label {
  font-size: 24rpx;
  color: #656D76;
  margin-top: 8rpx;
}

.action-bar {
  display: flex;
  gap: 16rpx;
  padding: 0 24rpx 24rpx;
}

.btn {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 28rpx;
  border-radius: 8rpx;
  border: none;
}

.btn-primary {
  background: #0969DA;
  color: #FFFFFF;
}

.btn-primary[disabled] {
  background: #54AEFF;
  color: #FFFFFF;
}

.btn-secondary {
  background: #F6F8FA;
  color: #1F2328;
  border: 1rpx solid #D0D7DE;
}

.btn-secondary[disabled] {
  background: #F6F8FA;
  color: #8C959F;
  border: 1rpx solid #D0D7DE;
}

.test-list {
  padding: 0 24rpx;
}

.test-item {
  background: #FFFFFF;
  border: 1rpx solid #D0D7DE;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
}

.test-header {
  display: flex;
  align-items: center;
  padding: 24rpx;
  gap: 16rpx;
}

.test-status {
  font-size: 32rpx;
  width: 48rpx;
  text-align: center;
}

.test-status.running {
  animation: spin 1s linear infinite;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.test-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.test-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1F2328;
}

.test-action {
  font-size: 24rpx;
  color: #656D76;
  font-family: monospace;
}

.test-duration {
  font-size: 24rpx;
  color: #656D76;
  font-family: monospace;
}

.test-detail {
  padding: 16rpx 24rpx;
  background: #F6F8FA;
  border-top: 1rpx solid #D0D7DE;
}

.error-text {
  font-size: 26rpx;
  color: #CF222E;
  line-height: 1.5;
}

.sample {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.sample-label {
  font-size: 24rpx;
  color: #656D76;
  font-weight: 600;
}

.sample-text {
  font-size: 22rpx;
  color: #656D76;
  font-family: monospace;
  word-break: break-all;
  line-height: 1.4;
}

.copy-btn {
  align-self: flex-end;
  font-size: 24rpx;
  color: #0969DA;
  padding: 8rpx 16rpx;
}
