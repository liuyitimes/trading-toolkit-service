<view class="container">
  <view class="header">
    <text class="title">接口测试</text>
    <text class="subtitle">共 {{summary.total}} 个测试用例</text>
  </view>

  <view class="summary-card">
    <view class="summary-row">
      <view class="summary-item">
        <text class="summary-value pass">{{summary.pass}}</text>
        <text class="summary-label">通过</text>
      </view>
      <view class="summary-item">
        <text class="summary-value fail">{{summary.fail}}</text>
        <text class="summary-label">失败</text>
      </view>
      <view class="summary-item">
        <text class="summary-value error">{{summary.error}}</text>
        <text class="summary-label">错误</text>
      </view>
      <view class="summary-item">
        <text class="summary-value">{{summary.duration}}ms</text>
        <text class="summary-label">耗时</text>
      </view>
    </view>
  </view>

  <view class="action-bar">
    <button class="btn btn-primary" bindtap="onRunAll" disabled="{{running}}">{{runAllBtnText}}</button>
    <button class="btn btn-secondary" bindtap="onExportAll" disabled="{{running}}">导出报告</button>
  </view>

  <view class="test-list">
    <view class="test-item" wx:for="{{tests}}" wx:key="id">
      <view class="test-header" bindtap="onRunSingle" data-id="{{item.id}}" data-index="{{index}}">
        <view class="test-status {{item.status}}">
          <text wx:if="{{item.status === 'pending'}}">⏳</text>
          <text wx:elif="{{item.status === 'running'}}">🔄</text>
          <text wx:elif="{{item.status === 'pass'}}">✅</text>
          <text wx:elif="{{item.status === 'fail'}}">❌</text>
          <text wx:elif="{{item.status === 'error'}}">💥</text>
        </view>
        <view class="test-info">
          <text class="test-name">{{item.name}}</text>
          <text class="test-action">{{item.action}}</text>
        </view>
        <view class="test-duration" wx:if="{{item.duration > 0}}">
          {{item.duration}}ms
        </view>
      </view>
      <view class="test-detail" wx:if="{{item.error}}">
        <text class="error-text">{{item.error}}</text>
      </view>
      <view class="test-detail sample" wx:if="{{item.dataSample}}">
        <text class="sample-label">数据样例:</text>
        <text class="sample-text">{{item.dataSample}}</text>
        <view class="copy-btn" catchtap="onCopyLog" data-index="{{index}}">复制日志</view>
      </view>
    </view>
  </view>
</view>
