.container {
  min-height: 100vh;
  background: var(--bg-color);
}

.header-card {
  background: var(--card-bg);
  padding: 32rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.header-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.exchange-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  height: 36rpx;
  border-radius: 6rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #fff;
  flex-shrink: 0;
}

.exchange-icon.sh {
  background: var(--danger-color);
}

.exchange-icon.sz {
  background: var(--success-color);
}

.exchange-icon.bj {
  background: #8250DF;
}

.exchange-icon.hk {
  background: var(--primary-color);
}

.bond-name {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.favorite-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-color);
  border-radius: 50%;
  border: 1rpx solid var(--border-color);
}

.favorite-btn.active {
  background: #FFF8C5;
  border-color: #EAC54F;
}

.fav-icon {
  font-size: 36rpx;
  color: var(--text-muted);
}

.favorite-btn.active .fav-icon {
  color: #9A6700;
}

.price-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.price-value {
  font-size: 72rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1;
}

.stock-row {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 8rpx 16rpx;
  background: var(--bg-color);
  border-radius: 20rpx;
}

.stock-name {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.stock-arrow {
  font-size: 28rpx;
  color: var(--text-muted);
}

.metrics-row {
  display: flex;
  gap: 20rpx;
}

.metric-item {
  flex: 1;
  text-align: center;
  padding: 16rpx;
  background: var(--bg-color);
  border-radius: 12rpx;
}

.metric-label {
  display: block;
  font-size: 22rpx;
  color: var(--text-muted);
  margin-bottom: 8rpx;
}

.metric-value {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.metric-value.negative {
  color: var(--success-color);
}

.metric-value.highlight {
  color: var(--primary-color);
}

.section {
  margin: 24rpx 20rpx;
  background: var(--card-bg);
  border: 1rpx solid var(--border-color);
  border-radius: var(--radius-lg);
  padding: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 20rpx;
  display: block;
}

.info-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.info-item {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.info-item.full {
  grid-column: 1 / -1;
}

.info-label {
  font-size: 22rpx;
  color: var(--text-muted);
}

.info-value {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.info-value.copyable {
  color: var(--primary-color);
  text-decoration: underline;
}

.info-value.coupon {
  font-size: 24rpx;
  line-height: 1.6;
  white-space: normal;
}

.coupon-item {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--border-color);
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.bottom-space {
  height: 60rpx;
}
