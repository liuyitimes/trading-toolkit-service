<view class="container {{isDarkMode ? 'dark-mode' : ''}}">
  <view class="banner">
    <view class="banner-bg"></view>
    <view class="banner-content" bindtap="switchQuote">
      <view class="letter-wrapper">
        <view class="letter-content">
          <text class="quote-text {{quoteFading ? 'fading' : ''}}" style="font-size: {{quoteFontSize}}rpx;">{{displayedQuote}}</text>
        </view>
        <view class="quote-author-row">
          <view class="author-line"></view>
          <text class="quote-author">{{currentAuthor}}</text>
        </view>
      </view>
    </view>
    <view class="quote-indicators">
      <view class="indicator {{index === currentQuoteIndex ? 'active' : ''}}" wx:for="{{quotes}}" wx:key="index"></view>
    </view>
    <view class="tap-tip">
      <text class="tap-tip-text">点击换一句</text>
    </view>
  </view>

  <view class="tabs">
    <view class="tab {{currentTab === 'market' ? 'active' : ''}}" bindtap="setTab" data-tab="market">市场概览</view>
    <view class="tab {{currentTab === 'ipo' ? 'active' : ''}}" bindtap="setTab" data-tab="ipo">打新日历</view>
    <view class="tab {{currentTab === 'signals' ? 'active' : ''}}" bindtap="setTab" data-tab="signals">中签查询</view>
  </view>

  <view class="content" wx:if="{{currentTab === 'market'}}">
    <view class="card-section">
      <view class="section-header">
        <text class="section-title">市场情绪</text>
        <view class="sentiment-badge {{sentimentLevel}}">
          <text>{{sentimentText}}</text>
        </view>
      </view>
      <view class="sentiment-body">
        <!-- 左侧：圆形仪表 -->
        <view class="sentiment-gauge-wrap" bindtap="openFormulaModal">
          <view class="sentiment-gauge">
            <view class="gauge-bg"></view>
            <view class="gauge-fill {{sentimentLevel}}" style="--deg: {{mergedSentimentPercent * 1.8}}deg;"></view>
            <view class="gauge-cover">
              <text class="gauge-value {{sentimentLevel}}">{{mergedSentiment}}</text>
              <text class="gauge-label">综合分</text>
            </view>
          </view>
        </view>
        <!-- 右侧：合并数据 -->
        <view class="sentiment-detail-col">
          <view class="sentiment-detail-item">
            <view class="detail-meta detail-meta-grid">
              <view class="meta-cell">
                <text class="meta-label">成交额</text>
                <text class="meta-val">{{sentimentDetail.totalVolume}}</text>
              </view>
              <view class="meta-cell">
                <text class="meta-label">上涨</text>
                <text class="meta-val positive">{{sentimentDetail.totalUpCount}}</text>
              </view>
              <view class="meta-cell">
                <text class="meta-label">下跌</text>
                <text class="meta-val negative">{{sentimentDetail.totalDownCount}}</text>
              </view>
            </view>
          </view>
          <text class="sentiment-tap-hint" bindtap="openSentimentModal">点击查看详情 ›</text>
        </view>
      </view>
    </view>

    <view class="card-section">
      <view class="section-header">
        <view class="section-title-row">
          <text class="section-title">资金方向</text>
          <text class="section-subtitle">主力净流入</text>
        </view>
        <view class="info-icon" bindtap="showFundFlowInfo">ⓘ</view>
      </view>
      <view class="net-inflow-bar {{fundFlowNet ? '' : 'hidden'}}">
        <view class="net-inflow-row">
          <text class="net-inflow-label">大盘净流入</text>
          <text class="net-inflow-value {{fundFlowNet.netTrend}}">{{fundFlowNet.netInflowText}}亿</text>
        </view>
        <view class="net-inflow-detail">
          <text class="net-inflow-detail-item">总流入 {{fundFlowNet.totalInflow}}亿</text>
          <text class="net-inflow-divider">|</text>
          <text class="net-inflow-detail-item">总流出 {{fundFlowNet.totalOutflow}}亿</text>
        </view>
      </view>
      <view class="fund-flow-grid" bindtap="openFundFlowModal">
        <view class="fund-flow-item" wx:for="{{topSectors}}" wx:key="name">
          <text class="fund-flow-label">{{item.name}}</text>
          <text class="fund-flow-value {{item.trend}}">{{item.flowText}}</text>
          <text class="fund-flow-unit">亿</text>
        </view>
      </view>
    </view>

    <view class="card-section">
      <view class="section-header">
        <text class="section-title">板块指引</text>
      </view>
      
      <view class="guide-card" bindtap="goToConvertible">
        <view class="guide-header">
          <view class="guide-title-row">
            <text class="guide-icon">📈</text>
            <text class="guide-title">可转债</text>
          </view>
          <text class="guide-arrow">›</text>
        </view>
        <view class="guide-metrics">
          <view class="guide-metric">
            <text class="metric-value">{{bondCount}}</text>
            <text class="metric-label">存续数量</text>
          </view>
          <view class="guide-metric">
            <text class="metric-value">{{doubleLowMedian}}</text>
            <text class="metric-label">双低中位数</text>
          </view>
          <view class="guide-metric">
            <text class="metric-value {{premiumMedian < 0 ? 'positive' : ''}}">{{premiumMedian}}%</text>
            <text class="metric-label">溢价中位数</text>
          </view>
        </view>
      </view>

      <view class="guide-card" bindtap="goToLof">
        <view class="guide-header">
          <view class="guide-title-row">
            <text class="guide-icon">📊</text>
            <text class="guide-title">LOF基金</text>
          </view>
          <text class="guide-arrow">›</text>
        </view>
        <view class="guide-metrics">
          <view class="guide-metric">
            <text class="metric-value">{{lofCount}}</text>
            <text class="metric-label">基金数量</text>
          </view>
          <view class="guide-metric">
            <text class="metric-value {{lofPremiumAvg < 0 ? 'positive' : ''}}">{{lofPremiumAvg}}%</text>
            <text class="metric-label">平均溢价</text>
          </view>
          <view class="guide-metric">
            <text class="metric-value">{{priceMedian}}</text>
            <text class="metric-label">价格中位数</text>
          </view>
        </view>
      </view>

      <view class="guide-card" bindtap="goToHkipo">
        <view class="guide-header">
          <view class="guide-title-row">
            <text class="guide-icon">🇭🇰</text>
            <text class="guide-title">港股打新</text>
          </view>
          <text class="guide-arrow">›</text>
        </view>
        <view class="guide-metrics">
          <view class="guide-metric">
            <text class="metric-value">{{ipoUpcoming}}</text>
            <text class="metric-label">待申购</text>
          </view>
          <view class="guide-metric">
            <text class="metric-value {{ipoAvgReturn >= 0 ? 'positive' : 'negative'}}">{{ipoAvgReturn}}%</text>
            <text class="metric-label">平均收益</text>
          </view>
          <view class="guide-metric">
            <text class="metric-value">{{ipoDrawCount}}</text>
            <text class="metric-label">近期上市</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="content" wx:if="{{currentTab === 'ipo'}}">
    <view class="ipo-calendar">
      <view class="calendar-header">
        <view class="calendar-nav">
          <text class="nav-btn" bindtap="prevMonth">‹</text>
          <text class="calendar-month">{{calendarMonthLabel}}</text>
          <text class="nav-btn" bindtap="nextMonth">›</text>
        </view>
        <view class="calendar-legend">
          <view class="legend-item">
            <view class="legend-dot subscribe"></view>
            <text class="legend-text">申购</text>
          </view>
          <view class="legend-item">
            <view class="legend-dot draw"></view>
            <text class="legend-text">抽签</text>
          </view>
          <view class="legend-item">
            <view class="legend-dot list"></view>
            <text class="legend-text">上市</text>
          </view>
        </view>
      </view>
      <view class="calendar-weekdays">
        <text class="weekday">日</text>
        <text class="weekday">一</text>
        <text class="weekday">二</text>
        <text class="weekday">三</text>
        <text class="weekday">四</text>
        <text class="weekday">五</text>
        <text class="weekday">六</text>
      </view>
      <view class="calendar-days">
        <view class="day {{item.isEmpty ? 'empty' : ''}} {{item.isToday ? 'today' : ''}} {{item.hasEvents ? 'has-events' : ''}}" wx:for="{{calendarDays}}" wx:key="index" bindtap="onDayTap" data-index="{{index}}">
          <text wx:if="{{!item.isEmpty}}">{{item.day}}</text>
          <view class="day-markers" wx:if="{{item.hasEvents}}">
            <view class="marker subscribe" wx:if="{{item.markerTypes.indexOf('subscribe') >= 0}}"></view>
            <view class="marker draw" wx:if="{{item.markerTypes.indexOf('draw') >= 0}}"></view>
            <view class="marker list" wx:if="{{item.markerTypes.indexOf('list') >= 0}}"></view>
          </view>
        </view>
      </view>
    </view>

    <!-- 日期事件弹窗 -->
    <view class="day-events-overlay" wx:if="{{showDayEvents}}" bindtap="closeDayEvents">
      <view class="day-events-panel" catchtap="">
        <view class="day-events-header">
          <text class="day-events-title">当日打新事件</text>
          <text class="day-events-close" bindtap="closeDayEvents">×</text>
        </view>
        <view class="day-events-list">
          <view class="day-event-item" wx:for="{{selectedDayEvents}}" wx:key="index">
            <view class="event-type-tag {{item.type}}">
              <text wx:if="{{item.type === 'subscribe'}}">申购</text>
              <text wx:elif="{{item.type === 'draw'}}">抽签</text>
              <text wx:elif="{{item.type === 'list'}}">上市</text>
            </view>
            <text class="event-name">{{item.name}}</text>
            <text class="event-code">{{item.code}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="ipo-list">
      <view class="ipo-header">
        <text class="ipo-title">今日新债/新股 ({{ipoDrawCount}}只)</text>
      </view>
      <view class="ipo-card" wx:for="{{ipoDrawList}}" wx:key="index">
        <view class="ipo-card-left" bindtap="openIpoDetail" data-index="{{index}}">
          <view class="ipo-info">
            <view class="ipo-name-row">
              <text class="exchange-icon hk" wx:if="{{item.market === '港'}}">港</text>
              <text class="exchange-icon sh" wx:elif="{{item.market === '沪'}}">沪</text>
              <text class="exchange-icon sz" wx:elif="{{item.market === '深'}}">深</text>
              <text class="exchange-icon bj" wx:elif="{{item.market === '京'}}">京</text>
              <text class="ipo-name">{{item.name}}</text>
            </view>
            <text class="ipo-code">{{item.code}} · {{item.type}}</text>
          </view>
          <view class="ipo-details">
            <view class="ipo-detail-row">
              <text class="ipo-detail-label">发行价:</text>
              <text class="ipo-detail-value">{{item.ipo_price}}{{item.type === '可转债' ? '元' : '元/股'}}</text>
            </view>
            <view class="ipo-detail-row">
              <text class="ipo-detail-label" wx:if="{{item.status === '已上市'}}">首日表现:</text>
              <text class="ipo-detail-label" wx:elif="{{item.win_rate}}">中签率:</text>
              <text class="ipo-detail-label" wx:else>状态:</text>
              <text class="ipo-detail-value {{item.change_pct >= 0 ? 'positive' : 'negative'}}" wx:if="{{item.status === '已上市' && item.change_pct != null}}">{{item.change_pct}}%</text>
              <text class="ipo-detail-value" wx:elif="{{item.win_rate}}">{{item.win_rate}}%</text>
              <text class="ipo-detail-value" wx:else>{{item.status}}</text>
            </view>
          </view>
        </view>
        <view class="ipo-card-right">
          <view class="ipo-action-btn {{item.subscribed ? 'subscribed' : ''}}" bindtap="toggleSubscribe" data-index="{{index}}" catchtap="toggleSubscribe" wx:if="{{item.status === '申购中'}}">
            <text>{{item.subscribed ? '已申购' : '申购'}}</text>
          </view>
          <view class="ipo-action-btn {{item.won ? 'won' : 'outline'}}" bindtap="toggleWin" data-index="{{index}}" catchtap="toggleWin" wx:elif="{{item.status === '中签公布'}}">
            <text>{{item.won ? '已中签' : '中签？'}}</text>
          </view>
          <view class="ipo-action-btn disabled" wx:elif="{{item.status === '已上市'}}">
            <text>已上市</text>
          </view>
          <view class="ipo-action-btn outline" wx:else>
            <text>{{item.status}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="content" wx:if="{{currentTab === 'signals'}}">
    <view class="lottery-win-card">
      <view class="lottery-win-left">
        <text class="lottery-win-label">已中签</text>
        <text class="lottery-win-count">{{winCount}}</text>
        <text class="lottery-win-unit">次</text>
      </view>
      <view class="lottery-win-right" bindtap="goToWinRecords">
        <text class="lottery-win-link">中签记录</text>
        <text class="lottery-win-arrow">›</text>
      </view>
    </view>

    <view class="lottery-form-card">
      <view class="form-section">
        <text class="form-label">新股/新债</text>
        <picker mode="selector" range="{{lotteryTargetList}}" range-key="name" bindchange="selectLotteryTarget" value="{{lotteryTargetIndex}}">
          <view class="form-picker">
            <text class="picker-value" wx:if="{{lotteryTargetList.length > 0}}">{{lotteryTargetList[lotteryTargetIndex].name}}</text>
            <text class="picker-placeholder" wx:else>请选择要查询的标的</text>
            <text class="picker-arrow">▾</text>
          </view>
        </picker>
      </view>

      <view class="form-section">
        <view class="form-label-row">
          <text class="form-label">起始配售号</text>
          <text class="form-tip-icon">ⓘ</text>
        </view>
        <input class="form-input" type="number" placeholder="请输入你的起始配售号码" value="{{lotteryStartNumber}}" bindinput="onStartNumberInput" />
      </view>

      <view class="form-section">
        <text class="form-label">配号数量</text>
        <view class="count-input-row">
          <view class="count-btn" bindtap="minusLotteryCount">-</view>
          <input class="count-input" type="number" value="{{lotteryCount}}" bindinput="onLotteryCountInput" />
          <view class="count-btn" bindtap="plusLotteryCount">+</view>
        </view>
      </view>

      <button class="query-btn" bindtap="doLotteryQuery" disabled="{{!lotteryStartNumber}}">查询</button>
    </view>
  </view>

  <view class="modal-overlay" wx:if="{{showSentimentModal}}" bindtap="closeSentimentModal">
    <view class="modal-content sentiment-modal" catchtap="">
      <view class="modal-header">
        <text class="modal-title">市场情绪详情</text>
        <view class="modal-close" bindtap="closeSentimentModal">×</view>
      </view>
      <view class="modal-body">
        <view class="detail-section">
          <text class="detail-section-title">基础数据</text>
          <view class="detail-grid">
            <view class="detail-item">
              <text class="detail-label">综合情绪分</text>
              <text class="detail-value {{sentimentLevel}}">{{mergedSentiment}}</text>
            </view>
            <view class="detail-item">
              <text class="detail-label">两市成交额</text>
              <text class="detail-value">{{sentimentDetail.totalVolume}}</text>
            </view>
            <view class="detail-item">
              <text class="detail-label">两市上涨</text>
              <text class="detail-value positive">{{sentimentDetail.totalUpCount}}</text>
            </view>
            <view class="detail-item">
              <text class="detail-label">两市下跌</text>
              <text class="detail-value negative">{{sentimentDetail.totalDownCount}}</text>
            </view>
            <view class="detail-item">
              <text class="detail-label">沪市成交</text>
              <text class="detail-value">{{sentimentDetail.shVolume}}</text>
            </view>
            <view class="detail-item">
              <text class="detail-label">深市成交</text>
              <text class="detail-value">{{sentimentDetail.szVolume}}</text>
            </view>
          </view>
        </view>

        <view class="detail-section">
          <text class="detail-section-title">情绪分级说明</text>
          <view class="level-list">
            <view class="level-item">
              <view class="level-dot hot"></view>
              <text class="level-text">过热 (≥70)：市场亢奋，注意风险</text>
            </view>
            <view class="level-item">
              <view class="level-dot warm"></view>
              <text class="level-text">偏热 (55-70)：情绪偏暖，谨慎乐观</text>
            </view>
            <view class="level-item">
              <view class="level-dot neutral"></view>
              <text class="level-text">中性 (35-55)：多空平衡，震荡为主</text>
            </view>
            <view class="level-item">
              <view class="level-dot cool"></view>
              <text class="level-text">偏冷 (25-35)：情绪偏弱，关注机会</text>
            </view>
            <view class="level-item">
              <view class="level-dot cold"></view>
              <text class="level-text">过冷 (≤25)：市场低迷，布局良机</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="modal-overlay" wx:if="{{showFormulaModal}}" bindtap="closeFormulaModal">
    <view class="modal-content sentiment-modal" catchtap="">
      <view class="modal-header">
        <text class="modal-title">情绪分计算</text>
        <view class="modal-close" bindtap="closeFormulaModal">×</view>
      </view>
      <view class="modal-body">
        <view class="detail-section">
          <text class="detail-section-title">计算公式</text>
          <view class="formula-box">
            <text class="formula-text">综合情绪分 = 涨跌分 × 60% + 量能趋势分 × 40%</text>
          </view>
          <view class="formula-calc">
            <text class="formula-calc-text">= {{sentimentFormula.ratioScore}} × 0.6 + {{sentimentFormula.volTrendScore}} × 0.4 = {{mergedSentiment}}</text>
          </view>
        </view>

        <view class="detail-section">
          <text class="detail-section-title">计算参数</text>
          <view class="calc-params">
            <view class="calc-param-row">
              <text class="calc-param-label">涨跌得分</text>
              <text class="calc-param-value">{{sentimentFormula.ratioScore}}</text>
            </view>
            <view class="calc-param-row">
              <text class="calc-param-label">涨跌权重</text>
              <text class="calc-param-value">60%</text>
            </view>
            <view class="calc-param-row">
              <text class="calc-param-label">量能趋势分</text>
              <text class="calc-param-value">{{sentimentFormula.volTrendScore}}</text>
            </view>
            <view class="calc-param-row">
              <text class="calc-param-label">量能权重</text>
              <text class="calc-param-value">40%</text>
            </view>
            <view class="calc-param-row">
              <text class="calc-param-label">昨成交量</text>
              <text class="calc-param-value">{{sentimentFormula.prevVolume}}亿</text>
            </view>
            <view class="calc-param-row">
              <text class="calc-param-label">量比</text>
              <text class="calc-param-value">{{sentimentFormula.volumeChangePct}}%</text>
            </view>
            <view class="calc-param-row">
              <text class="calc-param-label">5日均量</text>
              <text class="calc-param-value">{{sentimentFormula.vol5dAvg}}亿</text>
            </view>
            <view class="calc-param-row">
              <text class="calc-param-label">vs 5日均量</text>
              <text class="calc-param-value">{{sentimentFormula.vol5dChangePct}}%</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="modal-overlay" wx:if="{{showFundFlowTip}}" bindtap="closeFundFlowTip">
    <view class="modal-content tip-modal" catchtap="">
      <view class="modal-header">
        <text class="modal-title">数据说明</text>
        <view class="modal-close" bindtap="closeFundFlowTip">×</view>
      </view>
      <view class="modal-body">
        <view class="tip-content">
          <text class="tip-text">📊 板块资金流向更新频率：</text>
          <text class="tip-text-highlight">实时更新</text>
          <text class="tip-text-note">数据来源于东方财富公开信息，展示各行业板块主力资金净流入/流出情况。</text>
        </view>
        <view class="tip-content">
          <text class="tip-text">💡 如何解读？</text>
          <text class="tip-text-note">主力资金净流入越大，说明该板块越受资金青睐，可能存在上涨动力；净流出则相反。</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 资金分板块弹窗 -->
  <view class="modal-overlay" wx:if="{{showFundFlowModal}}" bindtap="closeFundFlowModal">
    <view class="modal-content fund-flow-modal" catchtap="">
      <view class="modal-header">
        <text class="modal-title">资金板块流向</text>
        <view class="modal-close" bindtap="closeFundFlowModal">×</view>
      </view>
      <view class="modal-body">
      <view class="chart-tabs" catchtap="">
        <view class="chart-tab {{fundFlowChartType === 'treemap' ? 'active' : ''}}" catchtap="switchFundFlowChart" data-type="treemap">云图</view>
        <view class="chart-tab {{fundFlowChartType === 'bubble' ? 'active' : ''}}" catchtap="switchFundFlowChart" data-type="bubble">泡泡图</view>
      </view>
      <!-- 云图 -->
      <view class="treemap-container" wx:if="{{fundFlowChartType === 'treemap'}}">
        <view class="treemap-row">
          <block wx:for="{{sectorFlowList}}" wx:key="name">
            <view class="treemap-item {{item.trend}}" style="flex-grow: {{item.percent}};" wx:if="{{index < 2}}">
              <text class="treemap-name">{{item.name}}</text>
              <text class="treemap-value">{{item.flowText}}亿</text>
            </view>
          </block>
        </view>
        <view class="treemap-row">
          <block wx:for="{{sectorFlowList}}" wx:key="name">
            <view class="treemap-item {{item.trend}}" style="flex-grow: {{item.percent}};" wx:if="{{index >= 2 && index < 5}}">
              <text class="treemap-name">{{item.name}}</text>
              <text class="treemap-value">{{item.flowText}}亿</text>
            </view>
          </block>
        </view>
        <view class="treemap-row">
          <block wx:for="{{sectorFlowList}}" wx:key="name">
            <view class="treemap-item {{item.trend}}" style="flex-grow: {{item.percent}};" wx:if="{{index >= 5}}">
              <text class="treemap-name">{{item.name}}</text>
              <text class="treemap-value">{{item.flowText}}亿</text>
            </view>
          </block>
        </view>
      </view>
      <!-- 泡泡图 -->
      <view class="bubble-container" wx:if="{{fundFlowChartType === 'bubble'}}">
        <view class="bubble-section bubble-section-positive">
          <view class="bubble-pyramid-row" wx:for="{{positivePyramid}}" wx:for-item="row" wx:key="index">
            <view class="bubble positive"
              wx:for="{{row}}" wx:for-item="item" wx:key="name"
              style="width: {{40 + item.percent * 1.2}}rpx; height: {{40 + item.percent * 1.2}}rpx;"
            >
              <text class="bubble-name">{{item.name}}</text>
              <text class="bubble-value">{{item.flowText}}</text>
            </view>
          </view>
        </view>
        <view class="bubble-divider"></view>
        <view class="bubble-section bubble-section-negative">
          <view class="bubble-pyramid-row" wx:for="{{negativePyramid}}" wx:for-item="row" wx:key="index">
            <view class="bubble negative"
              wx:for="{{row}}" wx:for-item="item" wx:key="name"
              style="width: {{40 + item.percent * 1.2}}rpx; height: {{40 + item.percent * 1.2}}rpx;"
            >
              <text class="bubble-name">{{item.name}}</text>
              <text class="bubble-value">{{item.flowText}}</text>
            </view>
          </view>
        </view>
      </view>
      </view>
    </view>
  </view>

  <view class="modal-overlay" wx:if="{{showIpoDetailModal && selectedIpo}}" bindtap="closeIpoDetailModal">
    <view class="modal-content ipo-detail-modal" catchtap="">
      <view class="modal-header">
        <view class="ipo-detail-title-row">
          <text class="exchange-icon hk" wx:if="{{selectedIpo.market === '港'}}">港</text>
          <text class="exchange-icon sh" wx:elif="{{selectedIpo.market === '沪'}}">沪</text>
          <text class="exchange-icon sz" wx:elif="{{selectedIpo.market === '深'}}">深</text>
          <text class="modal-title">{{selectedIpo.name}}</text>
        </view>
        <view class="modal-close" bindtap="closeIpoDetailModal">×</view>
      </view>
      <view class="modal-body">
        <view class="ipo-detail-info">
          <view class="ipo-detail-tag">{{selectedIpo.type}}</view>
          <text class="ipo-detail-code">代码：{{selectedIpo.code}}</text>
        </view>

        <view class="detail-section">
          <text class="detail-section-title">发行流程</text>
          <scroll-view class="timeline-scroll" scroll-x enable-flex>
            <view class="timeline-horizontal">
              <view class="timeline-node {{item.done ? 'done' : ''}} {{item.current ? 'current' : ''}}" wx:for="{{selectedIpo.timeline}}" wx:for-item="item" wx:key="step">
                <view class="timeline-node-dot">
                  <text class="timeline-node-icon" wx:if="{{item.done}}">✓</text>
                  <text class="timeline-node-num" wx:elif="{{item.current}}">{{index + 1}}</text>
                </view>
                <text class="timeline-node-step">{{item.step}}</text>
                <text class="timeline-node-date">{{item.date}}</text>
              </view>
              <view class="timeline-node-line" wx:for="{{selectedIpo.timeline}}" wx:for-item="item" wx:key="step" wx:if="{{index < selectedIpo.timeline.length - 1}}">
                <view class="timeline-line-seg {{item.done ? 'done' : ''}}"></view>
              </view>
            </view>
          </scroll-view>
        </view>

        <view class="detail-section">
          <text class="detail-section-title">发行数据</text>
          <view class="detail-grid">
            <view class="detail-item">
              <text class="detail-label">发行价</text>
              <text class="detail-value">{{selectedIpo.ipo_price}}{{selectedIpo.type === '可转债' ? '元' : '元/股'}}</text>
            </view>
            <view class="detail-item">
              <text class="detail-label">每手/签</text>
              <text class="detail-value">{{selectedIpo.lot_size || '--'}}{{selectedIpo.type === '可转债' ? '张' : '股'}}</text>
            </view>
            <view class="detail-item" wx:if="{{selectedIpo.win_rate != null}}">
              <text class="detail-label">中签率</text>
              <text class="detail-value">{{selectedIpo.win_rate}}%</text>
            </view>
            <view class="detail-item" wx:if="{{selectedIpo.issue_size}}">
              <text class="detail-label">发行规模</text>
              <text class="detail-value">{{selectedIpo.issue_size}}</text>
            </view>
            <view class="detail-item" wx:if="{{selectedIpo.pe_ratio}}">
              <text class="detail-label">市盈率</text>
              <text class="detail-value">{{selectedIpo.pe_ratio}}</text>
            </view>
            <view class="detail-item" wx:if="{{selectedIpo.industry}}">
              <text class="detail-label">所属行业</text>
              <text class="detail-value">{{selectedIpo.industry}}</text>
            </view>
            <view class="detail-item">
              <text class="detail-label">来源市场</text>
              <text class="detail-value">{{selectedIpo.market}}市</text>
            </view>
            <view class="detail-item" wx:if="{{selectedIpo.list_date}}">
              <text class="detail-label">上市日期</text>
              <text class="detail-value">{{selectedIpo.list_date}}</text>
            </view>
            <view class="detail-item" wx:if="{{selectedIpo.change_pct != null}}">
              <text class="detail-label">首日涨跌幅</text>
              <text class="detail-value {{selectedIpo.change_pct >= 0 ? 'positive' : 'negative'}}">{{selectedIpo.change_pct}}%</text>
            </view>
          </view>
        </view>

        <view class="detail-section" wx:if="{{selectedIpo.status === '申购中'}}">
          <text class="detail-section-title">申购提示</text>
          <view class="tips-box">
            <text class="tips-text">• 请在申购日交易时段内提交申购</text>
            <text class="tips-text">• 中签结果一般在T+2日公布</text>
            <text class="tips-text">• 中签后请确保账户有足够资金缴款</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="loading-tip" wx:if="{{loadProgress}}">
    <view class="loading-tip-spinner"></view>
    <text class="loading-tip-text">{{loadProgress}}</text>
  </view>

  <view class="load-error" wx:if="{{loadError}}">
    <text class="load-error-text">{{loadError}}</text>
  </view>
</view>
