.dark-mode .form-picker {
  background: #0D1117;
  border-color: #30363D;
}

.dark-mode .picker-value {
  color: #E6EDF3;
}

.dark-mode .picker-placeholder {
  color: #6E7681;
}

.dark-mode .picker-arrow {
  color: #6E7681;
}

.dark-mode .form-input {
  background: #0D1117;
  border-color: #30363D;
  color: #E6EDF3;
}

.dark-mode .count-input {
  background: #0D1117;
  border-color: #30363D;
  color: #E6EDF3;
}

.dark-mode .count-btn {
  background: #21262D;
  color: #E6EDF3;
}

.dark-mode .query-btn[disabled] {
  background: #21262D;
  color: #6E7681;
}

/* 弹窗 */
.dark-mode .modal-content {
  background: #161B22;
}

.dark-mode .modal-title {
  color: #E6EDF3;
}

.dark-mode .modal-close {
  color: #8B949E;
}

.dark-mode .detail-section-title {
  color: #E6EDF3;
}

.dark-mode .detail-label {
  color: #8B949E;
}

.dark-mode .detail-value {
  color: #E6EDF3;
}

.dark-mode .detail-value.positive {
  color: #F85149;
}

.dark-mode .detail-value.negative {
  color: #3FB950;
}

.dark-mode .formula-box {
  background: #0D1117;
}

.dark-mode .formula-text {
  color: #E6EDF3;
}

.dark-mode .formula-calc-text {
  color: #F0C850;
}

.dark-mode .level-text {
  color: #8B949E;
}

.dark-mode .tip-text {
  color: #E6EDF3;
}

.dark-mode .tip-text-highlight {
  color: #D29922;
}

.dark-mode .tip-text-note {
  color: #8B949E;
}

.dark-mode .tips-box {
  background: #0D1117;
}

.dark-mode .tips-text {
  color: #8B949E;
}

.dark-mode .timeline-node-step {
  color: #8B949E;
}

.dark-mode .timeline-node-date {
  color: #6E7681;
}

.dark-mode .ipo-detail-tag {
  background: #1A3A5C;
  color: #F0C850;
}

.dark-mode .ipo-detail-code {
  color: #8B949E;
}

/* 加载和错误遮罩 */
.dark-mode .loading-overlay {
  background: #0D1117;
}

.dark-mode .loading-spinner {
  border-color: #30363D;
  border-top-color: #F0C850;
}

.dark-mode .loading-text {
  color: #8B949E;
}

/* 资金弹窗暗夜模式 */
.dark-mode .chart-tab {
  background: #0D1117;
  color: #8B949E;
  border-color: #30363D;
}

.dark-mode .chart-tab.active {
  background: #F0C850;
  color: #0D1117;
  border-color: #F0C850;
}

.dark-mode .treemap-item.positive {
  background: rgba(248, 81, 73, 0.1);
  border-color: rgba(248, 81, 73, 0.25);
}

.dark-mode .treemap-item.negative {
  background: rgba(63, 185, 80, 0.1);
  border-color: rgba(63, 185, 80, 0.25);
}

.dark-mode .treemap-name {
  color: #8B949E;
}

.dark-mode .treemap-item.positive .treemap-value {
  color: #F85149;
}

.dark-mode .treemap-item.negative .treemap-value {
  color: #3FB950;
}

.dark-mode .bubble.positive {
  background: rgba(248, 81, 73, 0.12);
  border-color: rgba(248, 81, 73, 0.3);
}

.dark-mode .bubble.negative {
  background: rgba(63, 185, 80, 0.12);
  border-color: rgba(63, 185, 80, 0.3);
}

.dark-mode .bubble-name {
  color: #8B949E;
}

.dark-mode .bubble.positive .bubble-value {
  color: #F85149;
}

.dark-mode .bubble.negative .bubble-value {
  color: #3FB950;
}

.dark-mode .bubble-divider {
  background: #30363D;
}