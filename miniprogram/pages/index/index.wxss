/* ==================== 首页样式 - 旺财金主题 ==================== */
.container {
  min-height: 100vh;
  background: #F8F7F4;
}

.mock-tip {
  background: linear-gradient(135deg, rgba(212, 160, 23, 0.1) 0%, rgba(240, 200, 80, 0.1) 100%);
  border-bottom: 1rpx solid rgba(212, 160, 23, 0.3);
  padding: 16rpx 32rpx;
  text-align: center;
}

.mock-tip-text {
  font-size: 24rpx;
  color: #B8860B;
  font-weight: 500;
}

/* ==================== 顶部横幅（名言轮播）==================== */
.banner {
  position: relative;
  height: 320rpx;
  overflow: hidden;
  background: #1A1A2E;
}

.banner-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, #0D0D1A 0%, #1A1A35 50%, #1A1A2E 100%);
}

.banner-bg::before {
  content: '';
  position: absolute;
  top: -50%;
  right: -20%;
  width: 300rpx;
  height: 300rpx;
  background: radial-gradient(circle, rgba(212, 160, 23, 0.12) 0%, transparent 70%);
  border-radius: 50%;
}

.banner-bg::after {
  content: '';
  position: absolute;
  bottom: -30%;
  left: -10%;
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle, rgba(212, 160, 23, 0.08) 0%, transparent 70%);
  border-radius: 50%;
}

.banner-content {
  position: relative;
  z-index: 1;
  padding: 48rpx 56rpx 40rpx;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  box-sizing: border-box;
}

.banner-content::before,
.banner-content::after {
  position: absolute;
  font-size: 120rpx;
  font-family: Georgia, 'Times New Roman', serif;
  color: rgba(212, 160, 23, 0.12);
  font-weight: 700;
  line-height: 1;
  z-index: 0;
  pointer-events: none;
}

.banner-content::before {
  content: '\201C';
  top: 16rpx;
  left: 32rpx;
}

.banner-content::after {
  content: '\201D';
  bottom: 48rpx;
  right: 32rpx;
}

.letter-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  position: relative;
  z-index: 1;
}

.letter-content {
  display: inline-flex;
  flex-wrap: wrap;
  justify-content: center;
  align-items: flex-start;
  line-height: 1.7;
}

.quote-text {
  font-weight: 500;
  color: rgba(255, 255, 255, 0.95);
  letter-spacing: 2rpx;
  line-height: 1.7;
  text-align: center;
  font-size: 36rpx;
  transition: opacity 0.3s ease;
}

.quote-text.fading {
  opacity: 0;
}

.quote-author-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 24rpx;
}

.author-line {
  width: 40rpx;
  height: 2rpx;
  background: rgba(212, 160, 23, 0.5);
}

.quote-author {
  font-size: 26rpx;
  color: rgba(212, 160, 23, 0.8);
  font-weight: 500;
  letter-spacing: 1rpx;
}

.quote-indicators {
  position: absolute;
  bottom: 52rpx;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: 10rpx;
}

.indicator {
  width: 8rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: rgba(255, 255, 255, 0.2);
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

.indicator.active {
  width: 28rpx;
  background: linear-gradient(90deg, #D4A017 0%, #F0C850 100%);
  box-shadow: 0 0 12rpx rgba(240, 200, 80, 0.4);
}

.tap-tip {
  position: absolute;
  bottom: 16rpx;
  left: 50%;
  transform: translateX(-50%);
}

.tap-tip-text {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.25);
  letter-spacing: 2rpx;
}

/* ==================== 标签页 ==================== */
.tabs {
  display: flex;
  background: #FFFFFF;
  border-bottom: 1rpx solid #E5E2D9;
  padding: 0 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(26, 26, 46, 0.04);
}

.tab {
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
  font-size: 28rpx;
  color: #5A5A6E;
  border-bottom: 4rpx solid transparent;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  font-weight: 500;
}

.tab.active {
  color: #D4A017;
  font-weight: 700;
  border-bottom-color: #D4A017;
}

/* ==================== 内容区域 ==================== */
.content {
  padding: 20rpx;
}

/* ==================== 卡片区块 ==================== */
.card-section {
  background: #FFFFFF;
  border: 1rpx solid #D0D7DE;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 28rpx 16rpx;
  border-bottom: 1rpx solid #D0D7DE;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1F2328;
}

.section-subtitle {
  font-size: 24rpx;
  color: #818B98;
}

/* ==================== 市场情绪 ==================== */
.sentiment-badge {
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.sentiment-badge.hot {
  background: #FFEBE9;
  color: #CF222E;
  border: 1rpx solid #FFCECB;
}

.sentiment-badge.warm {
  background: #FFF8C5;
  color: #9A6700;
  border: 1rpx solid #EAC54F;
}

.sentiment-badge.neutral {
  background: #DDF4FF;
  color: #D4A017;
  border: 1rpx solid #54AEFF;
}

.sentiment-badge.cool {
  background: #DAFBE1;
  color: #1A7F37;
  border: 1rpx solid #4AC26B;
}

.sentiment-badge.cold {
  background: #DAFBE1;
  color: #1A7F37;
  border: 1rpx solid #4AC26B;
}

.sentiment-body {
  display: flex;
  padding: 28rpx 24rpx;
  gap: 32rpx;
  align-items: center;
}

/* 左侧圆形仪表 */
.sentiment-gauge-wrap {
  flex-shrink: 0;
}

.sentiment-gauge {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.gauge-bg {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  background: conic-gradient(
    #DAFBE1 0deg,
    #DAFBE1 60deg,
    #DDF4FF 120deg,
    #FFF8C5 180deg,
    #FFEBE9 240deg,
    #CF222E 360deg
  );
  opacity: 0.15;
}

.gauge-fill {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  background: conic-gradient(
    transparent 0deg,
    var(--clr, #2DA44E) var(--deg, 0deg),
    transparent var(--deg, 0deg)
  );
  mask: radial-gradient(transparent 56rpx, #000 57rpx);
  -webkit-mask: radial-gradient(transparent 56rpx, #000 57rpx);
}

.gauge-fill.hot {
  --clr: #CF222E;
}

.gauge-fill.warm {
  --clr: #9A6700;
}

.gauge-fill.neutral {
  --clr: #D4A017;
}

.gauge-fill.cool {
  --clr: #1A7F37;
}

.gauge-fill.cold {
  --clr: #1A7F37;
}

.gauge-cover {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #fff;
  border-radius: 50%;
  width: 120rpx;
  height: 120rpx;
}

.gauge-value {
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1;
}

.gauge-value.hot {
  color: #CF222E;
}

.gauge-value.warm {
  color: #9A6700;
}

.gauge-value.neutral {
  color: #D4A017;
}

.gauge-value.cool {
  color: #1A7F37;
}

.gauge-value.cold {
  color: #1A7F37;
}

.gauge-label {
  font-size: 20rpx;
  color: #818B98;
  margin-top: 4rpx;
}

/* 右侧分项数据 */
.sentiment-detail-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  min-width: 0;
}

.sentiment-detail-item {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.detail-name {
  font-size: 26rpx;
  color: #59636E;
  font-weight: 500;
}

.detail-score {
  font-size: 32rpx;
  font-weight: 700;
  color: #1F2328;
  line-height: 1;
}

.detail-score.hot {
  color: #CF222E;
}

.detail-score.warm {
  color: #9A6700;
}

.detail-score.neutral {
  color: #D4A017;
}

.detail-score.cool {
  color: #1A7F37;
}

.detail-score.cold {
  color: #1A7F37;
}

.detail-bar-track {
  width: 100%;
  height: 8rpx;
  background: #EAEEF2;
  border-radius: 4rpx;
  overflow: hidden;
}

.detail-bar-fill {
  height: 100%;
  border-radius: 4rpx;
  transition: width 0.6s cubic-bezier(0.4, 0, 0.2, 1);
}

.detail-bar-fill.hot {
  background: #CF222E;
}

.detail-bar-fill.warm {
  background: #9A6700;
}

.detail-bar-fill.neutral {
  background: #D4A017;
}

.detail-bar-fill.cool {
  background: #1A7F37;
}

.detail-bar-fill.cold {
  background: #1A7F37;
}

.detail-meta {
  display: flex;
  gap: 12rpx;
}

.meta-text {
  font-size: 20rpx;
  color: #818B98;
}

.meta-text.positive {
  color: #CF222E;
}

.meta-text.negative {
  color: #2DA44E;
}

.detail-meta-grid {
  display: flex;
  gap: 0;
  background: #F6F8FA;
  border-radius: 8rpx;
  overflow: hidden;
}

.meta-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 8rpx;
  gap: 4rpx;
}

.meta-cell + .meta-cell {
  border-left: 1rpx solid #E5E2D9;
}

.meta-label {
  font-size: 20rpx;
  color: #818B98;
}

.meta-val {
  font-size: 26rpx;
  font-weight: 600;
  color: #1F2328;
}

.meta-val.positive {
  color: #CF222E;
}

.meta-val.negative {
  color: #2DA44E;
}

.sentiment-tap-hint {
  font-size: 22rpx;
  color: #818B98;
  text-align: right;
  margin-top: 4rpx;
}

/* ==================== 资金方向 ==================== */
.fund-flow-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  padding: 24rpx;
}

.fund-flow-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx;
  background: #F6F8FA;
  border-radius: 8rpx;
  border: 1rpx solid #D0D7DE;
}

.fund-flow-label {
  font-size: 22rpx;
  color: #59636E;
  margin-bottom: 8rpx;
}

.fund-flow-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #1F2328;
  line-height: 1.2;
}

.fund-flow-value.positive {
  color: #CF222E;
}

.fund-flow-value.negative {
  color: #1A7F37;
}

.fund-flow-unit {
  font-size: 20rpx;
  color: #818B98;
  margin-top: 4rpx;
}

/* ==================== 板块指引 ==================== */
.guide-card {
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid #D0D7DE;
  transition: background 0.2s ease;
}

.guide-card:last-child {
  border-bottom: none;
}

.guide-card:active {
  background: #F6F8FA;
}

.guide-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.guide-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.guide-icon {
  font-size: 36rpx;
}

.guide-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1F2328;
}

.guide-arrow {
  font-size: 36rpx;
  color: #818B98;
}

.guide-metrics {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.guide-metric {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx;
  background: #F6F8FA;
  border-radius: 8rpx;
}

.metric-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #1F2328;
  line-height: 1.2;
  margin-bottom: 6rpx;
}

.metric-value.positive {
  color: #CF222E;
}

.metric-value.negative {
  color: #1A7F37;
}

.metric-label {
  font-size: 22rpx;
  color: #818B98;
}

/* ==================== 打新日历 ==================== */
.ipo-calendar {
  background: #FFFFFF;
  border: 1rpx solid #D0D7DE;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.calendar-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.calendar-month {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2328;
}

.calendar-legend {
  display: flex;
  gap: 16rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.legend-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}

.legend-dot.subscribe {
  background: #D4A017;
}

.legend-dot.draw {
  background: #8250DF;
}

.legend-dot.list {
  background: #2DA44E;
}

.legend-text {
  font-size: 22rpx;
  color: #59636E;
}

.calendar-weekdays {
  display: flex;
  margin-bottom: 12rpx;
}

.weekday {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #818B98;
  padding: 8rpx 0;
  font-weight: 500;
}

.calendar-days {
  display: flex;
  flex-wrap: wrap;
}

.day {
  width: calc(100% / 7);
  text-align: center;
  padding: 12rpx 0;
  font-size: 26rpx;
  color: #1F2328;
  position: relative;
}

.day.empty {
  color: transparent;
}

.day.today {
  background: #DDF4FF;
  border-radius: 8rpx;
  font-weight: 700;
  color: #D4A017;
}

.day-markers {
  display: flex;
  justify-content: center;
  gap: 4rpx;
  margin-top: 4rpx;
}

.marker {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
}

.marker.subscribe {
  background: #D4A017;
}

.marker.draw {
  background: #8250DF;
}

.marker.list {
  background: #2DA44E;
}

/* ==================== IPO列表 ==================== */
.ipo-list {
  background: #FFFFFF;
  border: 1rpx solid #D0D7DE;
  border-radius: 12rpx;
  padding: 24rpx;
}

.ipo-header {
  margin-bottom: 16rpx;
}

.ipo-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1F2328;
}

.ipo-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  background: #F6F8FA;
  border: 1rpx solid #D0D7DE;
  border-radius: 8rpx;
  margin-bottom: 12rpx;
  gap: 16rpx;
}

.ipo-card:last-child {
  margin-bottom: 0;
}

.ipo-card-left {
  flex: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-width: 0;
}

.ipo-card-right {
  flex-shrink: 0;
  display: flex;
  align-items: center;
}

.ipo-action-btn {
  padding: 12rpx 24rpx;
  border-radius: 32rpx;
  font-size: 24rpx;
  font-weight: 500;
  background: #D4A017;
  color: #fff;
  white-space: nowrap;
}

.ipo-action-btn.subscribed {
  background: #2DA44E;
}

.ipo-action-btn.won {
  background: #CF222E;
}

.ipo-action-btn.outline {
  background: transparent;
  color: #D4A017;
  border: 1rpx solid #D4A017;
}

.ipo-action-btn.disabled {
  background: #D0D7DE;
  color: #818B98;
}

.ipo-action-btn:active {
  opacity: 0.8;
}

.ipo-info {
  flex: 1;
  min-width: 0;
}

.ipo-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 6rpx;
}

.ipo-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2328;
}

.ipo-tag {
  padding: 4rpx 12rpx;
  background: #DDF4FF;
  color: #D4A017;
  border: 1rpx solid #54AEFF;
  border-radius: 20rpx;
  font-size: 20rpx;
  font-weight: 500;
}

.ipo-code {
  font-size: 24rpx;
  color: #818B98;
}

.ipo-details {
  display: flex;
  gap: 24rpx;
}

.ipo-detail-row {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.ipo-detail-label {
  font-size: 22rpx;
  color: #818B98;
}

.ipo-detail-value {
  font-size: 26rpx;
  font-weight: 600;
  color: #1F2328;
}

/* ==================== 信号标签页 ==================== */
.signal-tabs {
  display: flex;
  background: #FFFFFF;
  border: 1rpx solid #D0D7DE;
  border-radius: 8rpx;
  padding: 4rpx;
  margin-bottom: 20rpx;
}

.signal-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #59636E;
  border-radius: 6rpx;
  transition: all 0.2s ease;
  font-weight: 500;
}

.signal-tab.active {
  background: #1F2328;
  color: #fff;
  font-weight: 600;
}

/* ==================== 信号列表 ==================== */
.signal-list {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.signal-card {
  background: #FFFFFF;
  border: 1rpx solid #D0D7DE;
  border-radius: 8rpx;
  padding: 20rpx;
}

.signal-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 8rpx;
}

.signal-name-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex: 1;
}

.exchange-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 28rpx;
  height: 28rpx;
  border-radius: 4rpx;
  font-size: 18rpx;
  font-weight: 700;
  color: #fff;
  flex-shrink: 0;
}

.exchange-icon.sh {
  background: #CF222E;
}

.exchange-icon.sz {
  background: #1A7F37;
}

.exchange-icon.bj {
  background: #8250DF;
}

.exchange-icon.hk {
  background: #D4A017;
}

.signal-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1F2328;
}

.signal-code {
  font-size: 22rpx;
  color: #818B98;
  font-family: monospace;
  margin-bottom: 16rpx;
}

.signal-tag {
  padding: 4rpx 12rpx;
  background: #DDF4FF;
  color: #D4A017;
  border: 1rpx solid #54AEFF;
  border-radius: 20rpx;
  font-size: 20rpx;
  font-weight: 500;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.signal-body {
  display: flex;
  justify-content: space-between;
}

.signal-col {
  display: flex;
  flex-direction: column;
}

.signal-label {
  font-size: 22rpx;
  color: #818B98;
  margin-bottom: 4rpx;
}

.signal-value {
  font-size: 28rpx;
  font-weight: 600;
  color: #1F2328;
}

.signal-value.negative {
  color: #1A7F37;
}

.signal-value.highlight {
  color: #D4A017;
}

.signal-value.positive {
  color: #CF222E;
}

/* ==================== 加载状态 ==================== */
.loading-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: #F6F8FA;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.loading-content {
  text-align: center;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 3rpx solid #D0D7DE;
  border-top-color: #D4A017;
  border-radius: 50%;
  animation: spin 0.6s linear infinite;
  margin: 0 auto 16rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #59636E;
}

.section-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.info-icon {
  font-size: 32rpx;
  color: #818B98;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}


.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  padding: 40rpx;
}

.modal-content {
  background: #FFFFFF;
  border-radius: 16rpx;
  width: 100%;
  max-height: 80vh;
  overflow: hidden;
}

.sentiment-modal {
  max-width: 600rpx;
}

.tip-modal {
  max-width: 550rpx;
}

.ipo-detail-modal {
  max-width: 600rpx;
}

/* ==================== 资金分板块弹窗 ==================== */
.fund-flow-modal {
  max-width: 640rpx;
  max-height: 80vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.fund-flow-modal .modal-body {
  overflow-y: auto;
  flex: 1;
}

.chart-tabs {
  display: flex;
  padding: 16rpx 24rpx 0;
  gap: 12rpx;
}

.chart-tab {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 26rpx;
  color: #59636E;
  border-radius: 8rpx;
  background: #F6F8FA;
  border: 1rpx solid #D0D7DE;
  transition: all 0.2s ease;
  font-weight: 500;
}

.chart-tab.active {
  background: #1A1A2E;
  color: #fff;
  border-color: #1A1A2E;
  font-weight: 600;
}

.chart-tab:active {
  opacity: 0.8;
}

/* 云图 */
.treemap-container {
  padding: 20rpx 24rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  max-height: 600rpx;
  overflow-y: auto;
}

.treemap-row {
  display: flex;
  gap: 8rpx;
  height: 120rpx;
}

.treemap-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
  min-width: 0;
  overflow: hidden;
  padding: 8rpx;
  box-sizing: border-box;
  transition: all 0.3s ease;
}

.treemap-item.positive {
  background: rgba(207, 34, 46, 0.08);
  border: 1rpx solid rgba(207, 34, 46, 0.2);
}

.treemap-item.negative {
  background: rgba(26, 127, 55, 0.08);
  border: 1rpx solid rgba(26, 127, 55, 0.2);
}

.treemap-name {
  font-size: 22rpx;
  color: #59636E;
  font-weight: 500;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 100%;
}

.treemap-value {
  font-size: 24rpx;
  font-weight: 700;
  margin-top: 4rpx;
}

.treemap-item.positive .treemap-value {
  color: #CF222E;
}

.treemap-item.negative .treemap-value {
  color: #1A7F37;
}

/* 泡泡图 */
.bubble-container {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  max-height: 600rpx;
  overflow-y: auto;
}

.bubble-section {
  padding: 16rpx 0;
}

.bubble-section-positive {
  flex: 1;
}

.bubble-section-negative {
  flex: 1;
}

.bubble-divider {
  height: 2rpx;
  background: #D0D7DE;
  margin: 4rpx 0;
}

.bubble-pyramid-row {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.bubble-pyramid-row:last-child {
  margin-bottom: 0;
}

.bubble {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  box-sizing: border-box;
  padding: 8rpx;
  transition: all 0.3s ease;
}

.bubble.positive {
  background: rgba(207, 34, 46, 0.1);
  border: 2rpx solid rgba(207, 34, 46, 0.25);
}

.bubble.negative {
  background: rgba(26, 127, 55, 0.1);
  border: 2rpx solid rgba(26, 127, 55, 0.25);
}

.bubble-name {
  font-size: 20rpx;
  color: #59636E;
  font-weight: 500;
  white-space: nowrap;
}

.bubble-value {
  font-size: 22rpx;
  font-weight: 700;
}

.bubble.positive .bubble-value {
  color: #CF222E;
}

.bubble.negative .bubble-value {
  color: #1A7F37;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 28rpx 20rpx;
  border-bottom: 1rpx solid #D0D7DE;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1F2328;
}

.ipo-detail-title-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex: 1;
}

.modal-close {
  font-size: 40rpx;
  color: #818B98;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-body {
  padding: 24rpx 28rpx 28rpx;
  max-height: 60vh;
  overflow-y: auto;
}

.detail-section {
  margin-bottom: 24rpx;
}

.detail-section:last-child {
  margin-bottom: 0;
}

.detail-section-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #1F2328;
  margin-bottom: 16rpx;
}

.timeline-scroll {
  white-space: nowrap;
  margin: 0 -24rpx;
  padding: 0 24rpx;
  width: calc(100% + 48rpx);
}

.timeline-horizontal {
  display: flex;
  align-items: center;
  gap: 0;
}

.timeline-node {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 20rpx;
  flex-shrink: 0;
  position: relative;
}

.timeline-node-dot {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #EAEAEA;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
  transition: all 0.3s ease;
}

.timeline-node.done .timeline-node-dot {
  background: #2DA44E;
}

.timeline-node.current .timeline-node-dot {
  background: #D4A017;
  box-shadow: 0 0 0 6rpx rgba(9, 105, 218, 0.2);
  transform: scale(1.1);
}

.timeline-node-icon {
  font-size: 22rpx;
  color: #fff;
  font-weight: bold;
}

.timeline-node-num {
  font-size: 20rpx;
  color: #fff;
  font-weight: 600;
}

.timeline-node-step {
  font-size: 24rpx;
  color: #818B98;
  font-weight: 500;
  margin-bottom: 6rpx;
  text-align: center;
}

.timeline-node.done .timeline-node-step {
  color: #1F2328;
}

.timeline-node.current .timeline-node-step {
  color: #D4A017;
  font-weight: 600;
}

.timeline-node-date {
  font-size: 20rpx;
  color: #818B98;
}

.timeline-node.current .timeline-node-date {
  color: #D4A017;
  font-weight: 500;
}

.timeline-node-line {
  flex-shrink: 0;
}

.timeline-line-seg {
  width: 40rpx;
  height: 4rpx;
  background: #EAEAEA;
  margin-top: -24rpx;
}

.timeline-line-seg.done {
  background: #2DA44E;
}

.formula-box {
  background: #F6F8FA;
  border: 1rpx solid #D0D7DE;
  border-radius: 8rpx;
  padding: 20rpx;
  margin-bottom: 12rpx;
}

.formula-text {
  font-size: 26rpx;
  color: #1F2328;
  font-weight: 500;
}

.formula-calc {
  padding: 12rpx 20rpx;
}

.formula-calc-text {
  font-size: 24rpx;
  color: #59636E;
  font-family: monospace;
}

.detail-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
}

.detail-item {
  background: #F6F8FA;
  border-radius: 8rpx;
  padding: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.detail-label {
  font-size: 22rpx;
  color: #818B98;
}

.detail-value {
  font-size: 28rpx;
  font-weight: 600;
  color: #1F2328;
}

.detail-value.positive {
  color: #CF222E;
}

.detail-value.negative {
  color: #1A7F37;
}

.level-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.level-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.level-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.level-dot.hot {
  background: #CF222E;
}

.level-dot.warm {
  background: #EAC54F;
}

.level-dot.neutral {
  background: #D4A017;
}

.level-dot.cool {
  background: #4AC26B;
}

.level-dot.cold {
  background: #2DA44E;
}

.level-text {
  font-size: 24rpx;
  color: #59636E;
}

.tip-content {
  margin-bottom: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.tip-content:last-child {
  margin-bottom: 0;
}

.tip-text {
  font-size: 26rpx;
  color: #1F2328;
  font-weight: 500;
}

.tip-text-highlight {
  font-size: 30rpx;
  font-weight: 700;
  color: #D4A017;
}

.tip-text-note {
  font-size: 24rpx;
  color: #59636E;
  line-height: 1.6;
}

.ipo-detail-info {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #D0D7DE;
}

.ipo-detail-tag {
  padding: 6rpx 16rpx;
  background: #DDF4FF;
  color: #D4A017;
  border: 1rpx solid #54AEFF;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.ipo-detail-code {
  font-size: 24rpx;
  color: #818B98;
  font-family: monospace;
}

.tips-box {
  background: #FFF8C5;
  border-radius: 8rpx;
  padding: 16rpx 20rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.tips-text {
  font-size: 24rpx;
  color: #9A6700;
  line-height: 1.6;
}

.lottery-win-card {
  background: #FFFFFF;
  border: 1rpx solid #D0D7DE;
  border-radius: 12rpx;
  padding: 28rpx 24rpx;
  margin: 20rpx 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.lottery-win-left {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.lottery-win-label {
  font-size: 28rpx;
  color: #59636E;
  margin-right: 12rpx;
}

.lottery-win-count {
  font-size: 72rpx;
  font-weight: 700;
  color: #CF222E;
  line-height: 1;
}

.lottery-win-unit {
  font-size: 28rpx;
  color: #59636E;
}

.lottery-win-right {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.lottery-win-link {
  font-size: 26rpx;
  color: #D4A017;
}

.lottery-win-arrow {
  font-size: 32rpx;
  color: #D4A017;
}

.lottery-form-card {
  background: #FFFFFF;
  border: 1rpx solid #D0D7DE;
  border-radius: 12rpx;
  padding: 28rpx 24rpx;
}

.form-section {
  margin-bottom: 24rpx;
}

.form-section:last-of-type {
  margin-bottom: 32rpx;
}

.form-label {
  font-size: 26rpx;
  color: #59636E;
  margin-bottom: 12rpx;
  display: block;
}

.form-label-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 12rpx;
}

.form-tip-icon {
  font-size: 24rpx;
  color: #818B98;
}

.form-picker {
  background: #F6F8FA;
  border: 1rpx solid #D0D7DE;
  border-radius: 8rpx;
  padding: 20rpx 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.picker-value {
  font-size: 28rpx;
  color: #1F2328;
}

.picker-placeholder {
  font-size: 28rpx;
  color: #818B98;
}

.picker-arrow {
  font-size: 24rpx;
  color: #818B98;
}

.form-input {
  background: #F6F8FA;
  border: 1rpx solid #D0D7DE;
  border-radius: 8rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #1F2328;
  width: 100%;
  box-sizing: border-box;
}

.count-input-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.count-btn {
  width: 64rpx;
  height: 64rpx;
  background: #F6F8FA;
  border: 1rpx solid #D0D7DE;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #59636E;
  font-weight: 500;
}

.count-btn:active {
  background: #EAEEF2;
}

.count-input {
  flex: 1;
  background: #F6F8FA;
  border: 1rpx solid #D0D7DE;
  border-radius: 8rpx;
  padding: 16rpx 24rpx;
  font-size: 28rpx;
  color: #1F2328;
  text-align: center;
}

.query-btn {
  width: 100%;
  background: #E5E2D9;
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  border-radius: 12rpx;
  padding: 26rpx 0;
  border: none;
  letter-spacing: 2rpx;
  transition: all 0.3s ease;
}

.query-btn[disabled] {
  background: #E5E2D9;
  color: #9A9AB0;
}

.query-btn:not([disabled]) {
  background: linear-gradient(135deg, #D4A017 0%, #F0C850 100%);
  box-shadow: 0 6rpx 20rpx rgba(212, 160, 23, 0.35);
}

.query-btn:not([disabled]):active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(212, 160, 23, 0.3);
}

.ipo-card:active {
  background: #EAEEF2;
}

