/**app.wxss**/

/* ==================== 全局CSS变量 - 旺财金主题 ==================== */
page {
  --primary-color: #D4A017;
  --primary-light: #E8B938;
  --primary-dark: #B8860B;
  --primary-gradient: linear-gradient(135deg, #D4A017 0%, #F0C850 100%);
  --nav-bg: #1A1A2E;
  --success-color: #2D936C;
  --success-light: #3DAF80;
  --danger-color: #E63946;
  --danger-light: #F05A68;
  --warning-color: #D4A017;
  --accent-color: #9B59B6;
  --bg-color: #F8F7F4;
  --bg-secondary: #F0EEE8;
  --card-bg: #FFFFFF;
  --border-color: #E5E2D9;
  --border-muted: #EDEBE5;
  --text-primary: #1A1A2E;
  --text-secondary: #5A5A6E;
  --text-muted: #9A9AB0;
  --text-link: #D4A017;
  --shadow-sm: 0 2rpx 8rpx rgba(26, 26, 46, 0.04);
  --shadow-md: 0 4rpx 16rpx rgba(26, 26, 46, 0.08);
  --shadow-lg: 0 8rpx 32rpx rgba(26, 26, 46, 0.12);
  --shadow-gold: 0 4rpx 16rpx rgba(212, 160, 23, 0.25);
  --radius-sm: 8rpx;
  --radius-md: 12rpx;
  --radius-lg: 16rpx;
  --radius-xl: 24rpx;
  background-color: #F8F7F4;
}

/* ==================== 通用容器 ==================== */
.container {
  min-height: 100vh;
  background: var(--bg-color);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

/* ==================== 通用卡片 ==================== */
.card {
  background: var(--card-bg);
  border: none;
  border-radius: var(--radius-lg);
  padding: 28rpx;
  box-shadow: var(--shadow-sm);
}

.card + .card {
  margin-top: 24rpx;
}

/* ==================== 通用标题 ==================== */
.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
  letter-spacing: 0.5rpx;
}

/* ==================== 通用标签页 ==================== */
.tabs {
  display: flex;
  background: var(--card-bg);
  border-bottom: 1rpx solid var(--border-muted);
  padding: 0 20rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
  font-size: 28rpx;
  color: var(--text-secondary);
  border-bottom: 4rpx solid transparent;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  font-weight: 500;
  position: relative;
}

.tab.active {
  color: var(--primary-color);
  font-weight: 700;
  border-bottom-color: var(--primary-color);
}

/* ==================== 数字展示 ==================== */
.big-number {
  font-size: 56rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.2;
  letter-spacing: -1rpx;
}

.medium-number {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1.3;
}

.positive {
  color: var(--danger-color);
}

.negative {
  color: var(--success-color);
}

/* ==================== 通用按钮 ==================== */
.btn {
  padding: 20rpx 40rpx;
  border-radius: var(--radius-md);
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  border: none;
  background: var(--card-bg);
  color: var(--text-primary);
  box-shadow: var(--shadow-sm);
}

.btn-primary {
  background: var(--primary-gradient);
  color: #fff;
  box-shadow: var(--shadow-gold);
  letter-spacing: 1rpx;
}

.btn-primary:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(212, 160, 23, 0.3);
}

.btn-outline {
  background: var(--card-bg);
  color: var(--primary-color);
  border: 2rpx solid var(--primary-color);
  box-shadow: none;
}

.btn-outline:active {
  background: rgba(212, 160, 23, 0.08);
}

/* ==================== 通用加载状态 ==================== */
.loading-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--bg-color);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.loading-content {
  text-align: center;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 3rpx solid var(--border-color);
  border-top-color: var(--primary-color);
  border-radius: 50%;
  animation: spin 0.6s linear infinite;
  margin: 0 auto 16rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: var(--text-secondary);
}

/* ==================== 通用错误状态 ==================== */
.error-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--bg-color);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
  padding: 40rpx;
}

.error-content {
  text-align: center;
  max-width: 500rpx;
}

.error-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
  display: block;
}

.error-message {
  font-size: 30rpx;
  color: var(--text-secondary);
  margin-bottom: 32rpx;
  display: block;
  line-height: 1.6;
}

.error-btn {
  background: var(--success-light);
  color: #fff;
  border: 1rpx solid rgba(31, 35, 40, 0.15);
  border-radius: var(--radius-md);
  padding: 20rpx 48rpx;
  font-size: 28rpx;
  font-weight: 500;
}

/* ==================== 通用空状态 ==================== */
.empty {
  text-align: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
  opacity: 0.4;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-muted);
}

/* ==================== 通用标签 ==================== */
.tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
}

.tag-primary {
  background: linear-gradient(135deg, rgba(212, 160, 23, 0.12) 0%, rgba(240, 200, 80, 0.12) 100%);
  color: var(--primary-dark);
  border: 1rpx solid rgba(212, 160, 23, 0.3);
}

.tag-success {
  background: rgba(45, 147, 108, 0.1);
  color: var(--success-color);
  border: 1rpx solid rgba(45, 147, 108, 0.3);
}

.tag-danger {
  background: rgba(230, 57, 70, 0.1);
  color: var(--danger-color);
  border: 1rpx solid rgba(230, 57, 70, 0.3);
}

.tag-warning {
  background: rgba(212, 160, 23, 0.1);
  color: var(--primary-dark);
  border: 1rpx solid rgba(212, 160, 23, 0.3);
}

/* ==================== 通用值显示 ==================== */
.value-up {
  color: var(--danger-color) !important;
}

.value-down {
  color: var(--success-color) !important;
}

/* ==================== 交易所图标 ==================== */
.exchange-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 32rpx;
  height: 32rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: #fff;
  flex-shrink: 0;
  box-shadow: 0 2rpx 4rpx rgba(0,0,0,0.1);
}

.exchange-icon.sh {
  background: linear-gradient(135deg, #E63946 0%, #F05A68 100%);
}

.exchange-icon.sz {
  background: linear-gradient(135deg, #2D936C 0%, #3DAF80 100%);
}

.exchange-icon.bj {
  background: linear-gradient(135deg, #9B59B6 0%, #B07CC6 100%);
}

.exchange-icon.hk {
  background: linear-gradient(135deg, #3498DB 0%, #5DADE2 100%);
}

/* ==================== 重置样式 ==================== */
button {
  background: initial;
  margin: 0;
  padding: 0;
}

button::after {
  border: none;
}

input, textarea {
  outline: none;
}

input::placeholder,
textarea::placeholder {
  color: var(--text-muted);
}

/* ==================== 暗夜模式 - CSS变量覆盖 ==================== */
.dark-mode {
  --primary-color: #F0C850;
  --primary-light: #F5D878;
  --primary-dark: #D4A017;
  --primary-gradient: linear-gradient(135deg, #D4A017 0%, #F0C850 100%);
  --nav-bg: #0F0F1A;
  --success-color: #3DAF80;
  --success-light: #4EC091;
  --danger-color: #F05A68;
  --danger-light: #F57A86;
  --warning-color: #F0C850;
  --accent-color: #B07CC6;
  --bg-color: #0F0F1A;
  --bg-secondary: #1A1A2E;
  --card-bg: #1A1A2E;
  --border-color: #2A2A42;
  --border-muted: #222238;
  --text-primary: #F0EEE8;
  --text-secondary: #A0A0B8;
  --text-muted: #6A6A85;
  --text-link: #F0C850;
  --shadow-sm: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
  --shadow-md: 0 4rpx 16rpx rgba(0, 0, 0, 0.4);
  --shadow-lg: 0 8rpx 32rpx rgba(0, 0, 0, 0.5);
  --shadow-gold: 0 4rpx 16rpx rgba(240, 200, 80, 0.2);
  background-color: #0F0F1A;
}

.dark-mode .tag-primary {
  background: rgba(240, 200, 80, 0.15);
  color: #F0C850;
  border-color: rgba(240, 200, 80, 0.3);
}

.dark-mode .tag-success {
  background: rgba(61, 175, 128, 0.15);
  color: #3DAF80;
  border-color: rgba(61, 175, 128, 0.3);
}

.dark-mode .tag-danger {
  background: rgba(240, 90, 104, 0.15);
  color: #F05A68;
  border-color: rgba(240, 90, 104, 0.3);
}

.dark-mode .tag-warning {
  background: rgba(240, 200, 80, 0.15);
  color: #F0C850;
  border-color: rgba(240, 200, 80, 0.3);
}

.dark-mode .exchange-icon.sh {
  background: linear-gradient(135deg, #F05A68 0%, #F57A86 100%);
}

.dark-mode .exchange-icon.sz {
  background: linear-gradient(135deg, #3DAF80 0%, #4EC091 100%);
}

.dark-mode .exchange-icon.bj {
  background: linear-gradient(135deg, #B07CC6 0%, #C195D3 100%);
}

.dark-mode .exchange-icon.hk {
  background: linear-gradient(135deg, #5DADE2 0%, #7FBFE8 100%);
}
